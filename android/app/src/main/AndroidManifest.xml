<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Hardware Feature Declarations for High Performance Gaming -->
    <uses-feature android:glEsVersion="0x00030002" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.compute" android:version="0" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen.multitouch.distinct" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.software.game_service" android:required="false" />

    <!-- Optional Shizuku integration, used only when explicitly enabled. -->
    <uses-permission android:name="moe.shizuku.privileged.api.permission.USE_SHIZUKU" />

    <!-- User-granted Android settings and usage access. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Network Optimization & Low-Latency QoS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Bluetooth & Gaming Controller Connectivity (Android 14, 15, 16) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- Audio, Haptics, Overlay & System UI -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Package Visibility Queries for Android 13-16 (Target SDK 33-36) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GAME" />
        </intent>
        <!-- Mobile Legends: Bang Bang (MLBB) & Regional Variants -->
        <package android:name="com.mobile.legends" />
        <package android:name="com.mobilelegends.mi" />
        <package android:name="com.vng.mlbbvn" />
        <package android:name="com.mobilelegends.na" />
        <package android:name="com.mobile.legends.vng" />
        <package android:name="com.mobile.legends.kr" />
        <package android:name="com.mobile.legends.jp" />
        <package android:name="com.mobilelegends.hw" />
        <package android:name="com.mobile.legends.moonton" />

        <!-- Call of Duty: Mobile & Warzone Mobile -->
        <package android:name="com.garena.game.codm" />
        <package android:name="com.activision.callofduty.shooter" />
        <package android:name="com.vng.codmvn" />
        <package android:name="com.tencent.tmgp.kr.codm" />
        <package android:name="com.tencent.tmgp.cod" />
        <package android:name="com.activision.callofduty.warzone" />

        <!-- PUBG Mobile & Regional Variants & BGMI -->
        <package android:name="com.tencent.ig" />
        <package android:name="com.pubg.imobile" />
        <package android:name="com.pubg.krmobile" />
        <package android:name="com.vng.pubgmobile" />
        <package android:name="com.tencent.iglite" />
        <package android:name="com.pubg.newstate" />
        <package android:name="com.krafton.bgmi" />
        <package android:name="com.tencent.tmgp.pubgm" />

        <!-- Free Fire & Free Fire MAX -->
        <package android:name="com.dts.freefireth" />
        <package android:name="com.dts.freefiremax" />

        <!-- League of Legends: Wild Rift & TFT -->
        <package android:name="com.riotgames.league.wildrift" />
        <package android:name="com.riotgames.league.wildrifttw" />
        <package android:name="com.riotgames.league.wildriftvn" />
        <package android:name="com.riotgames.league.teamfighttactics" />

        <!-- Honor of Kings & Arena of Valor -->
        <package android:name="com.levelinfinite.sgameGlobal" />
        <package android:name="com.levelinfinite.sgameGlobal.gpkg" />
        <package android:name="com.tencent.tmgp.sgame" />
        <package android:name="com.garena.game.kgtw" />
        <package android:name="com.garena.game.kgvn" />
        <package android:name="com.garena.game.kgid" />

        <!-- Genshin Impact, HoYoverse & Kuro Games -->
        <package android:name="com.miHoYo.GenshinImpact" />
        <package android:name="com.cognosphere.GenshinImpact" />
        <package android:name="com.HoYoverse.hkrpgoversea" />
        <package android:name="com.HoYoverse.nap" />
        <package android:name="com.miHoYo.bh3oversea" />
        <package android:name="com.kurogame.wutheringwaves.global" />
        <package android:name="com.kurogame.kj" />

        <!-- Competitive Shooters & Action -->
        <package android:name="com.roblox.client" />
        <package android:name="com.axlebolt.standoff2" />
        <package android:name="com.netease.bloodstrike" />
        <package android:name="com.netease.newspike" />
        <package android:name="com.proximabeta.mf.uamo" />
        <package android:name="com.levelinfinite.deltaforce" />
        <package android:name="com.tencent.tmgp.dfm" />
        <package android:name="com.tencent.tmgp.projectc" />
        <package android:name="com.riotgames.valorantmobile" />
        <package android:name="com.tencent.tmgp.valorant" />
        <package android:name="com.riotgames.valorant" />
        <package android:name="com.miracle.farlight84" />
        <package android:name="com.miraclegames.farlight84" />
        <package android:name="com.farlightgames.farlight84.gp" />
        <package android:name="com.farlightgames.farlight84.global" />
        <package android:name="com.levelinfinite.hotta.gp" />
        <package android:name="com.netease.lztgglobal" />
        <package android:name="com.YoStar.AetherGazer" />

        <!-- Sports & Racing -->
        <package android:name="jp.konami.pesam" />
        <package android:name="com.ea.gp.fifamobile" />
        <package android:name="com.garena.game.fdtw" />
        <package android:name="com.gameloft.anmp.android.glofta9hm" />
        <package android:name="com.gameloft.android.ANMP.GloftA9HM" />
        <package android:name="com.h20.carxstreet" />
        <package android:name="com.ea.games.r3_row" />
        <package android:name="com.firsttouchgames.dls7" />
        <package android:name="com.fingersoft.hillclimb" />
        <package android:name="com.fingersoft.hcr2" />

        <!-- Supercell & Casual Hits -->
        <package android:name="com.supercell.brawlstars" />
        <package android:name="com.supercell.clashroyale" />
        <package android:name="com.supercell.clashofclans" />
        <package android:name="com.supercell.squad" />
        <package android:name="com.supercell.hayday" />
        <package android:name="com.mojang.minecraftpe" />
        <package android:name="com.kiloo.subwaysurf" />
        <package android:name="com.kitkagames.fallbuddies" />
        <package android:name="com.miniclip.eightballpool" />
        <package android:name="com.netmarble.sololv" />
        <package android:name="com.innersloth.spacemafia" />
        <package android:name="com.plarium.raidlegends" />
        <package android:name="com.habby.archero" />
        <package android:name="com.habby.punball" />
        <package android:name="com.habby.kinja" />
        <package android:name="com.nekki.shadowfight3" />
        <package android:name="com.nekki.shadowfight4" />
        <package android:name="com.chucklefish.stardewvalley" />
        <package android:name="com.rockstargames.gtasa" />
        <package android:name="com.rockstargames.gtavc" />
        <package android:name="com.rockstargames.gta3" />
        <package android:name="com.sega.sonicdash" />

        <!-- Third-Party Gaming Platforms & App Stores -->
        <package android:name="com.taptap.global" />
        <package android:name="com.taptap" />
        <package android:name="com.garena.appstore" />
        <package android:name="com.sec.android.app.samsungapps" />
        <package android:name="com.apkpure.aether" />
        <package android:name="com.qooapp.qoohelper" />

        <!-- Shizuku & System Package Queries -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name="com.gamebooster.app.GameBoosterApp"
        android:label="Game Booster"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.GameBooster"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:isGame="true"
        android:appCategory="game"
        android:hasFragileUserData="false"
        android:requestLegacyExternalStorage="true"
        android:enableOnBackInvokedCallback="true">

        <!-- Display & Gaming Engine Metadata -->
        <meta-data
            android:name="android.max_aspect"
            android:value="3.0" />
        <meta-data
            android:name="android.supports_size_changes"
            android:value="true" />
        <meta-data
            android:name="android.game_service"
            android:value="true" />
        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />
        <meta-data
            android:name="android.allow_multiple_resumed_activities"
            android:value="true" />
        <meta-data
            android:name="android.notch_support"
            android:value="true" />
        <meta-data
            android:name="notch.config"
            android:value="portrait|landscape" />
        <meta-data
            android:name="com.samsung.android.game.game_home"
            android:value="true" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="com.gamebooster.app.overlay.FloatingOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Game space performance monitoring overlay HUD" />
        </service>

        <service
            android:name="com.gamebooster.app.overlay.CrosshairOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Crosshair visual target overlay" />
        </service>

        <service
            android:name="com.gamebooster.app.gamespace.AutoGameMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Game space automatic game detection service" />
        </service>

        <service
            android:name="com.gamebooster.app.overlay.VisualFilterOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hardware Visual Clarity GPU filter shader" />
        </service>

        <service
            android:name="com.gamebooster.app.overlay.GameTurboEdgeService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="In-game slide-out gaming edge drawer" />
        </service>

        <service
            android:name="com.gamebooster.app.overlay.VirtualShoulderKeyService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Virtual shoulder trigger air keys" />
        </service>

        <receiver
            android:name="com.gamebooster.app.gamemanager.GameManagerScanBroadcast"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <activity
            android:name="com.gamebooster.app.ui.activities.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name="com.gamebooster.app.terminal.TerminalActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:label="Shizuku Core Console" />

        <activity
            android:name="com.gamebooster.app.ui.activities.WebBrowserActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:label="Game Launcher Web Search" />

    </application>
</manifest>
