gfx-enable-native-gfx-jobs=1
wait-for-native-debugger=0
vr-device-type=0
player-connection-debug=0
profiler-enable-gpu-profiler=0
gc-max-time-slice=3
single-threaded-rendering=0
hdr-display-mode=1
vulkan-enable-validation=0
vulkan-pipeline-cache=1
target-frame-rate=185

# ── 2026 CODM Combat Modifiers (Speed 150%, Damage 200%, Defense 80%, HP 300%, Crit 300%, Zero Recoil/Spread) ──
player-speed-multiplier=1.5
player-damage-multiplier=2.0
player-attack-multiplier=2.0
player-defence-mitigation=0.8
player-health-multiplier=3.0
player-critical-multiplier=3.0
weapon-recoil-scale=0.0
weapon-spread-scale=0.0
