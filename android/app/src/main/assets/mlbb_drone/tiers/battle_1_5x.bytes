	<!-- shader替换规则 -->
	<!-- 各种shader替换参数-->
	<AShaderReplaceParams sGrassLitMap="light7" fGrassLitMult="1" />
	
	<!-- A模型（会自己索引相关皮肤模型）使用RimLight效果时，Alpha不渐变，直接设为最终值 -->
	<AShaderRimLightNoAlphaLerpForModel>
		<SShaderRimLightNoAlphaLerpForModel sModel="hero_AamonCloak_skin" />
	</AShaderRimLightNoAlphaLerpForModel>
	
	<!-- A模型（会自己索引相关皮肤模型）替换成B/C/D shader时，新版使用默认shader，老版使用sShader -->
	<AShaderReplaceForbiddenForModel>
		<SShaderReplaceForbiddenForModel sModel="hero_AamonCloak_skin" sShader="Effect/FX_NoiseFlu" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT;MlHero/ML_InBattle_Diffuse_ALT_Low;MlHero/ML_FightTranslucent" />
		<SShaderReplaceForbiddenForModel sModel="hero_Novaria_bianshen_skin" sShader="Effect/FX_BodyStars_InBattle" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT;MlHero/ML_InBattle_Diffuse_ALT_Low;MlHero/ML_FightTranslucent" />
	</AShaderReplaceForbiddenForModel>
	
	<!-- 全局的技能锁排除，相当于在所有的SkillType表的Exceptions字段中加入了skillId（仅对英雄生效） -->
  <LockExceptionSkills arrayiSkills="25281"/>
  
  <!-- 禁止A模型的某个renderer（不会自己索引相关皮肤模型，因为不同皮肤下的renderer会不一样）替换成B/C/D shader -->
	<AShaderReplaceForbiddenForRenderer Dict="SShaderReplaceForbiddenForRenderer.sModel">
		<SShaderReplaceForbiddenForRenderer sModel="hero_evilgirl_skin" arraysRenderer="hair" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT" />
		<SShaderReplaceForbiddenForRenderer sModel="hero_evilgirl_skin01_add" arraysRenderer="hair" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT" />
		<SShaderReplaceForbiddenForRenderer sModel="hero_evilgirlnext_skin02_add" arraysRenderer="evilgirl_skin02_hair" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT" />
		<SShaderReplaceForbiddenForRenderer sModel="hero_evilgirl_skin03_add" arraysRenderer="hair" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT" />
		<SShaderReplaceForbiddenForRenderer sModel="hero_evilgirl_skin04_add" arraysRenderer="hair" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT" />
		<SShaderReplaceForbiddenForRenderer sModel="hero_evilgirl_skin05_add" arraysRenderer="hair" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT" />
		<SShaderReplaceForbiddenForRenderer sModel="hero_evilgirl_skin06_add" arraysRenderer="hair_skin06" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT" />
		<SShaderReplaceForbiddenForRenderer sModel="hero_evilgirl_skin07_add" arraysRenderer="evilgirl_skin07_hair" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT" />
		<SShaderReplaceForbiddenForRenderer sModel="hero_evilgirl_skin08_add" arraysRenderer="63_selena_skin08_1_hair" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT" />
		<SShaderReplaceForbiddenForRenderer sModel="hero_gongjianshou_skin11_add" arraysRenderer="m_Object_2" arraysForbidden="MlHero/ML_FightTranslucent" />
		<SShaderReplaceForbiddenForRenderer sModel="hero_beilanita_skin02_add" arraysRenderer="97" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT" />
		<SShaderReplaceForbiddenForRenderer sModel="hero_munaiyiballnext_skin04_add" arraysRenderer="nengliangqiu_01" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT" />	
		<SShaderReplaceForbiddenForRenderer sModel="hero_Cirrus_skin" arraysRenderer="131_cirrus_yun_skin;131_cirrus_leiyun_skin" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT;MlHero/ML_NHero_L1_T2_ALT" />	
		<SShaderReplaceForbiddenForRenderer sModel="Thero_kagura_skin04_add" arraysRenderer="TXplane" arraysForbidden="MlHero/ML_NHero_L1_T2_ALT;MlHero/ML_FightTranslucent" />  
		<SShaderReplaceForbiddenForRenderer sModel="hero_Hirara_skin" arraysRenderer="m_Object_1" arraysForbidden="MlHero/ML_FightTranslucent;MIHero/ML_NHero_L1_T2_ALT_Custom_Shadow;MIHero/ML_FightOutlineMical;Effect/Fresnel_HeightGradient" />   
		<SShaderReplaceForbiddenForRenderer sModel="hero_fashutanke_skin02_add" arraysRenderer="FX_Obj_a" arraysForbidden="ML/AdditiveUV_ML;MIHero/ML_FightTranslucent" />   
	</AShaderReplaceForbiddenForRenderer>
	
	<!-- 禁止A模型的某个renderer（不会自己索引相关皮肤模型，因为不同皮肤下的renderer会不一样）的某个材质的shader被替换 -->
	<AShaderReplaceForbiddenForMaterial Dict="SShaderReplaceForbiddenForMaterial.sModel">
		<SShaderReplaceForbiddenForMaterial sModel="hero_evilgirl_skin" arraysRenderer="hair" arrayiIgnoreMaterial="1" />
		<SShaderReplaceForbiddenForMaterial sModel="hero_wukong_skin01_add" arraysRenderer="wukong_skin01" arrayiIgnoreMaterial="1" />
		<SShaderReplaceForbiddenForMaterial sModel="hero_nextfreya_skin" arraysRenderer="22_freya_skin;22_freya_skin_chibang;22_freya_skin_wuqi" arrayiIgnoreMaterial="0;0;0" />
	</AShaderReplaceForbiddenForMaterial>
	
	<!-- 低于指定画质下，指定名字的shader要替换时，会直接使用默认shader -->
	<!-- iPictureMode, 1低，2中，3高，4极高，进游戏的画质小于等于iPictureMode时功能起效 -->
	<AShaderReplaceForbiddenForPictureMode Dict="SShaderReplaceForbiddenForPictureMode.sShader" >
		<SShaderReplaceForbiddenForPictureMode sShader="MlHero/ML_NHero_L1_T2_ALT" iPictureMode="1" />
	</AShaderReplaceForbiddenForPictureMode>

	<!-- 如果目标模型的shader前缀是sShader，收arraysOriginShader换成对应的arraysReplacedShader -->
