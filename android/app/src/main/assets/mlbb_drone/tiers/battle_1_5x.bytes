  <!--团战清晰度优化
	iAlpha透明度千分比
	iMaxParticles粒子数量千分比调整，向下取整
	iHide，0为不隐藏，1为隐藏，不填默认为0
  //特效 指定类型
    public enum EffectOriginType
    {
        EffectOrigin_Null,
        //起手特效
        EffectOrigin_SkillStart = 1,
        //攻击特效
        EffectOrigin_SkillAttack = 2,
        //循环特效
        EffectOrigin_SkillLoopAttack = 3,
        //被击特效
        EffectOrigin_BeTarget = 4,
        //状态特效
        EffectOrigin_Status = 5,
        //特殊效果 里面 配置的特效
        EffectOrigin_SpecialEffect = 6,
    }
    fMaxDis  团战距离
        fIntervalConditonTime  团战 检测间隔时间
        fIntervalDurTime   团战 持续时间
        iPlyerNum  团战 条件 触发多少个人

        100 是默认 等级特效
        200 定制 等级特效
	--> 
  <ParticleStrategy Dict="ParticleStrategyItem.iId" fMaxDis="6" fIntervalConditonTime="0.1" fIntervalDurTime="1" iPlyerNum="6">
	<ParticleStrategyItem iId="100" > 
                        <ParticleStrategyParams iId="1" iMiniScore="0" iMaxScore="0" iAlpha="800" iMaxParticles="1000" iHide="" iAlpha1="800" iMaxParticles1="1000" iHide1="" iAlpha2="800" iMaxParticles2="1000" iHide2="" iAlpha3="800" iMaxParticles3="1000" iHide3="" iSoundPlay="1000"/>
                        <ParticleStrategyParams iId="2" iMiniScore="0" iMaxScore="0" iAlpha="800" iMaxParticles="1000" iHide="" iAlpha1="800" iMaxParticles1="1000" iHide1="" iAlpha2="800" iMaxParticles2="1000" iHide2="" iAlpha3="800" iMaxParticles3="1000" iHide3="" iSoundPlay="1000"/>
                        <ParticleStrategyParams iId="3" iMiniScore="0" iMaxScore="0" iAlpha="800" iMaxParticles="1000" iHide="" iAlpha1="800" iMaxParticles1="1000" iHide1="" iAlpha2="800" iMaxParticles2="1000" iHide2="" iAlpha3="800" iMaxParticles3="1000" iHide3="" iSoundPlay="1000"/>
                        <ParticleStrategyParams iId="4" iMiniScore="0" iMaxScore="0" iAlpha="800" iMaxParticles="1000" iHide="" iAlpha1="800" iMaxParticles1="1000" iHide1="" iAlpha2="800" iMaxParticles2="1000" iHide2="" iAlpha3="800" iMaxParticles3="1000" iHide3="" iSoundPlay="1000"/>
                        <ParticleStrategyParams iId="5" iMiniScore="0" iMaxScore="0" iAlpha="800" iMaxParticles="1000" iHide="" iAlpha1="800" iMaxParticles1="1000" iHide1="" iAlpha2="800" iMaxParticles2="1000" iHide2="" iAlpha3="800" iMaxParticles3="1000" iHide3="" iSoundPlay="1000"/>
                        <ParticleStrategyParams iId="6" iMiniScore="0" iMaxScore="0" iAlpha="800" iMaxParticles="1000" iHide="" iAlpha1="800" iMaxParticles1="1000" iHide1="" iAlpha2="800" iMaxParticles2="1000" iHide2="" iAlpha3="800" iMaxParticles3="1000" iHide3="" iSoundPlay="1000"/>
                </ParticleStrategyItem>

  <ParticleStrategyItem iId="200" > 
                        <ParticleStrategyParams iId="1" iMiniScore="0" iMaxScore="0" iAlpha="1000" iMaxParticles="1000" iHide="" iAlpha1="1000" iMaxParticles1="1000" iHide1="" iAlpha2="1000" iMaxParticles2="1000" iHide2="" iAlpha3="800" iMaxParticles3="1000" iHide3="" iSoundPlay="1000"/>
                        <ParticleStrategyParams iId="2" iMiniScore="0" iMaxScore="0" iAlpha="660" iMaxParticles="1000" iHide="" iAlpha1="660" iMaxParticles1="1000" iHide1="" iAlpha2="660" iMaxParticles2="1000" iHide2="" iAlpha3="800" iMaxParticles3="1000" iHide3="" iSoundPlay="1000"/>
                        <ParticleStrategyParams iId="3" iMiniScore="0" iMaxScore="0" iAlpha="330" iMaxParticles="1000" iHide="" iAlpha1="330" iMaxParticles1="1000" iHide1="" iAlpha2="330" iMaxParticles2="1000" iHide2="" iAlpha3="800" iMaxParticles3="1000" iHide3="" iSoundPlay="1000"/>
                </ParticleStrategyItem>              
	</ParticleStrategy>

	<!-- 
	StrategySkillType 技能类型对应分数（1-10）
	0：高伤害
	1：高级控制（压制、变形、击飞、冰冻、石化、眩晕、恐惧、嘲讽、中远距离击退）
	2：高级防御类型（无敌、复活、隐身、免死、不可选中）
	3：中伤害
	4：中级控制（沉默、束缚、缴械、缚地）
	5：中级防御类型（霸体、护盾、净化）
	6：高级减益（降低治疗量）
	7：视觉效果（遮蔽视野）
	8：低伤害
	9：低级控制（短距离击退、拉拽、减速）
	10：低级防御类（免疫减速、免疫位移、免伤、回血）
	11：低级减益（降低攻击速度、属性降低）
	12：低级增益（冷却缩减、移速提升、攻速提升、属性增加）
	13：召唤召唤物、自身变形
	14：正常位移（有些仅为了表现的位移不算）
	15：短距离位移
	16；摘除完仅表现类
	-->
  <StrategySkillTypeData Dict="SkillTypeData.iType">
	<SkillTypeData iType="0" iScore="10" />
	<SkillTypeData iType="1" iScore="10" />
	<SkillTypeData iType="2" iScore="8" />
	<SkillTypeData iType="3" iScore="6" />
	<SkillTypeData iType="4" iScore="7" />
	<SkillTypeData iType="5" iScore="7" />
	<SkillTypeData iType="6" iScore="6" />
	<SkillTypeData iType="7" iScore="5" />
	<SkillTypeData iType="8" iScore="2" />
	<SkillTypeData iType="9" iScore="3" />
	<SkillTypeData iType="10" iScore="2" />
	<SkillTypeData iType="11" iScore="2" />
	<SkillTypeData iType="12" iScore="3" />
	<SkillTypeData iType="13" iScore="5" />
	<SkillTypeData iType="14" iScore="5" />
	<SkillTypeData iType="15" iScore="2" />
	<SkillTypeData iType="16" iScore="1" />
  </StrategySkillTypeData>

	<!-- 
	StrategyEffectType 特效类型对应的百分比影响（千分制）
	0：起手特效
	1：攻击特效
	2：蓄力特效
	3：受击特效
	4：子弹特效
	5：普通状态特效
	6：连线特效
	7：标记特效
	8：召唤物
	9: 预警特效
	10：带效果的状态特效
	11：出生、消散特效
	-->
  <StrategyEffectTypeData Dict="EffectTypeData.iType">
    <EffectTypeData iType="0" iScoreper="200" /> <!-- 起手特效 -->
    <EffectTypeData iType="1" iScoreper="1000" /> <!-- 攻击特效 -->
    <EffectTypeData iType="2" iScoreper="500" /> <!-- 蓄力特效 -->
    <EffectTypeData iType="3" iScoreper="400" /> <!-- 受击特效 -->
	<EffectTypeData iType="4" iScoreper="1000" /> <!-- 子弹特效 -->
	<EffectTypeData iType="5" iScoreper="300" /> <!-- 普通状态特效 -->
	<EffectTypeData iType="6" iScoreper="500" /> <!-- 连线特效 -->
	<EffectTypeData iType="7" iScoreper="700" /> <!-- 标记特效(废弃） -->
	<EffectTypeData iType="8" iScoreper="700" /> <!-- 召唤特效 -->
	<EffectTypeData iType="9" iScoreper="1000" /> <!-- 预警特效 -->
	<EffectTypeData iType="10" iScoreper="1000" /> <!-- 带效果的状态特效、标记特效 -->
	<EffectTypeData iType="11" iScoreper="200" /> <!-- 出生、消散特效 -->
  </StrategyEffectTypeData>
	
