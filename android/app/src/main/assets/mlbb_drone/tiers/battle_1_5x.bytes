	<EquipIconAltBySkinItem iId="10003" />
  </EquipIconAltBySkin>
  
    <!--
	  表情泡泡
	  iPaoPaoCD   CD
	  iAutoStarShow         气泡和特效对局第15秒固定显示，25秒后消失
	  iAutoStarHide			气泡和特效对局第10秒固定显示，20秒后消失
	  iRadius				触发范围半径为：5码
	  iShowMaxCount			单局对局中最多显示8次开关控制次数
	  iShowTime				事件触发的显示时间
	  iOffsetX				偏移量 X
	  iOffsetY				偏移量 Y
	  sEffObj    			特效名
	  -->
  <EMojiPaoPaoGuide iShowMaxCount="8" iPaoPaoCD="10000" iAutoStarShow="10000"  iAutoStarHide="20000" iShowTime="10000" iRadius="500" iOffsetX="0" iOffsetY="32" sEffObj="ui_effect_equip_zhuan_02" />
 <!--
  低端机下的声音限制
  hashsetsLoadBattleBnk 只在战斗加载
  hashsetsLoadAllBnk 战斗和登录都加载
  hashsetsPlayEvent 任何播放声音都会限制
 !-->
  <LowMachineLoadOptimize hashsetsLoadBattleBnk="ui03_sfx_append;ui_battle_sfx_append" hashsetsLoadAllBnk="ui_sfx_append" hashsetsPlayEvent="Play_ui_adddiamond;Play_ui_checkbox_off;Play_ui_checkbox_on;Play_ui_common_levelup2;Play_ui_pageopen;Play_ui_readme;Play_ui_systemset;Play_ui_gradeup_ex;Play_ui_hero_cd_complete;Play_ui_jueweistar;Play_ui_medal_get;Play_ui_medal_put;Play_ui_openshop;Play_ui_overdianzan;Play_ui_overkaipai;Play_ui_reborn;Play_ui_skill_warning;Play_ui_zhufuchenggong;Play_2060_qingwa;Play_storm_eye_born;Play_storm_eye_born_low"/>

<!--
   hashsetiNoMoneyEquipIDs:哪些装备ID卖了之后没钱
