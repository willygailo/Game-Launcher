   iCanBuyGankShoeTime:买了游走鞋后多少时间之内可以附魔游走
 -->
  <AShopSellGankRule hashsetiNoMoneyEquipIDs="" iNoGankShoeTime="120000" iCanBuyGankShoeTime="15000"/>
  
