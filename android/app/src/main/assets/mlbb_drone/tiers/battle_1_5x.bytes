  <!--pvptype 1，2的行为树ai难度;iRealPVPType是pvptype的2级类型 -->
  <!--1.hashsetiServerDifRealPVPType 优先取服务器指定的行为树难度aitype-->
  <!--2.iRealPVPType的难度取配置iDif-->
  <!--3.iDefaultDifficulty是默认难度-->
  <ABattleTreeAi Dict="ABattleTreeAiItem.iRealPVPType" iDefaultDifficulty="3" hashsetiServerDifRealPVPType="58">
    <ABattleTreeAiItem iRealPVPType="1"  iDif="4"/>
    <ABattleTreeAiItem iRealPVPType="2"  iDif="4"/>
    <ABattleTreeAiItem iRealPVPType="51"  iDif="3"/>
    <ABattleTreeAiItem iRealPVPType="57"  iDif="3"/>
  </ABattleTreeAi>
  <!--BattleStateAI相关IsWildMonster
    hashsetiHeroCantContinueSameSkill 状态机AI里不能连续使用同一技能的英雄，例如吉米如果一直用1技能，则2，3技能无法释放 
    hashsetiHeroCheckDestReached 添加英雄如果DriveNext的时候自己和目标路点很近则认为要去下个路点
    hashsetiHeroStateAI 测试用，填英雄id，可以不被深度AI接管
    BattleStateAIContinueSkillCount 状态机AI里可以优先连续放这个技能(iSkill)的次数(iCount)，例如蓄力一般是要放2次技能, 到大最大次数后iNextSkillInterval（单位ms）之后才能继续是否其他技能
    hashsetiHeroFixChargeSkill 填入需要修改蓄力技能释放问题的行为树的英雄ID
	hashsetiNeedSelfPosSkill 状态机AI使用CastSpellToEnemy接口释放技能时，位置参数需要填自身位置的技能
  -->
  <BattleStateAI Dict="BattleStateAIContinueSkillCount.iSkill" hashsetiHeroCantContinueSameSkill="71" hashsetiHeroCheckDestReached="71" hashsetiHeroStateAI="" hashsetiNeedSelfPosSkill="9110" hashsetiHeroFixChargeSkill="126">
    <BattleStateAIContinueSkillCount iSkill="5330" iCount="2" iNextSkillInterval="3500"/>
  </BattleStateAI>
  
  <!--BattleAI
    iBeforeTurnAISkill 转AI前释放一个技能，用来恢复一些托管前的非法状态，例如吉米按下普攻同时掉线再回来
    iBeforeExitAISkill 退出AI前释放一个技能，用来恢复一些托管时候的状态，例如蓄力
  -->
  <BattleAI Dict="BattleAIItem.iID">
    <BattleAIItem iID="71" iBeforeTurnAISkill="7171" iBeforeExitAISkill="7171"/>
    <BattleAIItem iID="105" iBeforeExitAISkill="2010532" />
    <BattleAIItem iID="32" iBeforeTurnAISkill="303232" />
    <BattleAIItem iID="125" iBeforeExitAISkill="12510" />
  </BattleAI>
  <!--需要忽略 BattleAICheckAtkDeadFighterTimeout检查的技能ID列表-->
  <BattleAICheckAtkDeadFighterTimeoutIgnoreSkills hashsetiSkillIDs="1469"/>
  <!--DLAICheckCastSkill
  arrayiTargetExcludeBuffs 施法对象身上不能有配置的buff;
  iCond
    1:青雀在墙上施法1技能需要检查释放点不在同一面墙上
-->
  <DLAICheckCastSkill Dict="DLAICheckCastSkillItem.iID">
    <DLAICheckCastSkillItem iID="11330" arrayiTargetExcludeBuffs="1134006"/>
    <DLAICheckCastSkillItem iID="8410" iCond="1" arrayiTargetExcludeBuffs="1134006"/>
  </DLAICheckCastSkill>

