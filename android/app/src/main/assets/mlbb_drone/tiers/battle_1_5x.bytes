  <!-- 异常状态检测值：这是一个底层的配置，注意不要轻易改动。当前使用二进制位处理
     iSilenceDisAct 2100130 1000000000101110100010 新状态是否为沉默打断类型
     iSilenceDisByStatusSpacial 2100252 1000000000110000011100 新状态是否为 特殊沉默打断类型
     iCanStatusMove 2231758 1000100000110111001110 包含死亡 状态锁，是否能移动
     iCheckStatusEnter 1023 1111111111 检测当前状态是否受免控影响——新增缴械类型
     sSkillState   { 2097152, 4096 }  检测当前状态位 技能UI是否锁定 {排除死亡 快速移动}可以扩展
	 hashsetiExcludSkillId，填写技能id，被填写id的技能，在受到短暂控制时候，依旧会显示图标禁用标志
	  --> 
  <AConfigFighterStatus iSilenceDisAct="2098082" iSilenceDisByStatusSpacial="2100252"   iCanStatusMove="2756046"  iCheckStatusEnter="1051647" sSkillStausEnable="2097152;4096" hashsetiExcludSkillId="2830;3020;29520;4120;4130;4410;7130;7810;8130;9640;12610;12630;12650"/>
  
<!-- 
        新版小兵排布配置
			"neighborDist">The maximum distance (center point to
         * center point) to other agents this agent takes into account in the
         * navigation. The larger this number, the longer the running time of
         * the simulation. If the number is too low, the simulation will not be
         * safe. Must be non-negative

         * "maxNeighbors">The maximum number of other agents this
         * agent takes into account in the navigation. The larger this number,
         * the longer the running time of the simulation. If the number is too
         * low, the simulation will not be safe.

         * "timeHorizon">The minimal amount of time for which this
         * agent's velocities that are computed by the simulation are safe with
         * respect to other agents. The larger this number, the sooner this
         * agent will respond to the presence of other agents, but the less
         * freedom this agent has in choosing its velocities. Must be positive.
         * 
         * "timeHorizonObst"The minimal amount of time for which
         * this agent's velocities that are computed by the simulation are safe
         * with respect to obstacles. The larger this number, the sooner this
         * agent will respond to the presence of obstacles, but the less freedom
         * this agent has in choosing its velocities. Must be positive.</param>
  --> 
<ARVO2Config fNeighborDist="4"   iMaxNeighbors="10"  fTimeHorizon="1"  fTimeHorizonObst="1"  fRadius="1"  fMaxSpeed="10"  iMaxAgentCount="100" fIldeMass="10" fRunMass="1" fMaxAbsSqr="8" />
 
 <!-- 
        iATKAddType            攻速平滑类型 >0 开启  1类型只检测吟唱 2类型只检测CD 3类型吟唱和CD都需要检测 4类型新的吟唱和CD检测
	    fRunTime               保护时间 这个事件内普攻都算做统一平滑处理
	    iDbugLog               是否打印日志
	    iSkillType             技能类型  0 检测当前触发技能 1 检测当前技能的原技能
		hashsetiIgnoreSkill    屏蔽的技能ID，不走该功能
		hashsetiActionSkill    只检测原技能的情况下，允许以下非原技能也走该功能
		hashsetiIgnoreHeroID   屏蔽英雄，屏蔽的英雄ID不走该功能
  -->
  
        <CoverAttackSpeedValue   iATKAddType="4"  fRunTime="3000"  iDbugLog="0"  iSkillType="1"  hashsetiIgnoreSkill="64;66;67;72;7201;10000;410000" hashsetiActionSkill="10001;10004;10092;410001" hashsetiIgnoreHeroID=""  />

 
