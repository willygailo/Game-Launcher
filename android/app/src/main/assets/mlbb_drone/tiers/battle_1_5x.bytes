 <!--智能信号配置: iTipStartDealy引导气泡开始显示的延迟 iTipStayTime引导气泡的显示时长 iTipShowMinLevel引导气泡显示的玩家最小等级-->
 <AChatSignal iTipStartDealy="20000" iTipStayTime="10000" iTipShowMinLevel="8"/>


  <!-- 自走棋8人详情界面: iMaxSkillAddIcon棋手受益最多显示几个图标 iMaxSkillInfoAddIcon棋手提示最多显示几个图标-->
 <AMagicChessPlayerDetail iMaxSkillAddIcon="4"  iMaxSkillInfoAddIcon="8"    />


  <!-- 自走棋清理内存提示：iMemoryClearTip（1：提示，0：不提示）-->
 <AMagicChessPerformanceConfig iMemoryClearTip="1"/>
  

   <!-- 电池设置: 开始播放低电特效的电量/开始弹出低电提示的电量-->
   <ABattterySetting iLowBatteryEffect="20" iLowBatteryTip="10"/>

   <!-- L1T1shader参数和镜头设置: fLitMult进入草丛后的Shader的LitMult值-->
   <ABL1T1ShaderSetting fLitMult="1" arrayiExceptions="" >
