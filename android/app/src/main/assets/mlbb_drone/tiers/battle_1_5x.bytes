  <!--持续伤害/金钱飘字叠加动画配置 -->
    <!--iType           1=金币飘字；2=组类型飘字(同一ID的效果合并，在Fpara12配置)；3//效果生效时(施加者)的所有伤害都会被合并(在SpecialEffect配置)；4//效果生效时任意伤害都会被合并(配置同左，哈利大招) -->
    <!--fAPPROACH_TIME      中间数值展示时间 这个时间结束后会变成最终的伤害值 然后进入 fSTAY_TIME -->
    <!--fSTAY_TIME        最终数值展示时间 这个时间结束后会播放动画sAniName3 然后进入 fEND_TIME -->
    <!--fEND_TIME         结束展示时间 这个时间结束后飘字会消失（新功能：若该时间填0，则不会播放结束动画，用于CombinehurtB1的特殊表现）-->
    <!--sAniName1/2/3       数字从无到有、从有到改变、结束时播放的动画-->
    <!--iNotApproachVal=1/0     不显示/显示趋近值-->
    <!--iColorR iColorG iColorB 颜色值，最大为255 -->
      <!--fScale            顶层节点的Scale-->
      <!--fPosX  fPosY        坐标额外偏移-->
  <HurtStayData iOnlyOneFlyText="1" fSoldierScaleRatio="0.75" fHeightOffset="0.08"> <!--iOnlyOneFlyText=1 只有一个飘字(即防御塔上的不再显示，只能填1) -->
    <!--fSoldierScaleRatio      新增对召唤物/小兵的伤害飘字的通用大小乘法系数-->
    <!--fHeightOffset         若某目标受到不同来源的合并伤害时，需要使目标身上的新伤害能基于原配置位置做一个向下0.1左右的偏移；多个同理-->
    <!--hashsetiMergeSrcSkill 该源技能产生的伤害都以所在配置的gruopId为准-->
    <!--iLimitHurtType 标识该组只能合指定伤害类型的,或者全类型合;0或者不配置则不限制,1物理2魔法3真实-->
    <!--iLimitHurtType 是GroupId的前置条件，非指定的HurtType 是一定不会合到对应的Group里的-->
    <StayType iId="-1" iType="1" fAPPROACH_TIME="0.05" fSTAY_TIME="2" fEND_TIME="1" sAniName1="Combinehurt1" sAniName2="Combinehurt2" sAniName3="Combinehurt3" iNotApproachVal="1" iColorR="255" iColorG="205" iColorB="75" fScale="1.2" fPosX="" fPosY="-0.3"/> <!-- 防御塔护盾金币 -->
  
    <StayType iId="1" iType="2" fAPPROACH_TIME="0.05" fSTAY_TIME="1.2" fEND_TIME="1" sAniName1="Combinehurt1" sAniName2="Combinehurt2" sAniName3="Combinehurt3" iNotApproachVal="1" iColorR="255" iColorG="59" iColorB="59" fScale="0.8" fPosX="-0.05" fPosY="-0.25"/> <!-- 物理飘字无过度：半藏 -->
    <StayType iId="2" iType="2" fAPPROACH_TIME="0.05" fSTAY_TIME="1.2" fEND_TIME="1" sAniName1="Combinehurt1" sAniName2="Combinehurt2" sAniName3="Combinehurt3" iNotApproachVal="1" iColorR="214" iColorG="64" iColorB="251"  fScale="0.8" fPosX="-0.05" fPosY="-0.4"/> <!-- 吉米（仅对防御塔，类型改为魔法） -->
