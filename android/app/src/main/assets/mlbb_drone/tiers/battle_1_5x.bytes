  <!--局内装备成长
  iSmallHeadDuration 装备小件头顶属性显示时长(毫秒)
  iSmallPreviewDuration 装备小件右侧预告显示时长(毫秒)
  iBigHeadDuration 装备大件头顶属性显示时长(毫秒)
  iBigPreviewDuration 装备大件右侧预告显示时长(毫秒)
  iGoldEffectInterval X秒内最多触发一次金币飘特效，X为可配置(毫秒)
  iTimeSinceBattleStart 战斗开始多久后才生效
  sGoldGetEffectName 右上角金币获取特效 iGoldGetEffectTime 金币获取特效时间
  sGoldFlyEffectName 金币飞行特效名字 iGoldFlyEffectTime 金币飞行特效时间
  sSmallPartGetEffectName 小件飞行特效名字 iSmallPartGetEffectTime 小件飞行特效时间
  sBigPartGetEffectName 大件飞行特效名字 iBigPartGetEffectTime 大件飞行特效时间
  sBigPartRefreshEffectName 大件右上角刷新特效名字 iBigPartRefreshEffectTime 大件右上角刷新特效时间
  iNextEffectWaitTime 头顶多久后显示下一次预告 iAutoBuyDelay 大件装备不点多久后自动购买
        iGoldMonsterMinValue="" 野怪 金币>=这个值才显示飞行特效
        iGoldHeroMinValue=""   英雄 金币>=这个值才显示飞行特效
        iGoldOtherValue=""     其他 金币>=这个值才显示飞行特效
  fDataXPos0 右上角KDA X位置,有三横时
  fDataXSize0 有三横时   右上角KDA BOX SizeX大小
  fDataXPos1 右上角KDA X位置,无三横时
  fDataXSize1 无三横时   右上角KDA BOX SizeX大小
  sGoldBeforeUpgradeEffectName 小件进度前金币特效
  iGoldBeforeUpgradeEffectTime 小件进度前金币特效时间
  iProgressDuration 小件进度动画时长
  iSmallUpgradeDuration 小件升级特效时长
  iEquipDelayShowTime 金币特效多长时间后才可以提示装备
  iGoldDelayBuyAfterGoldChanged 金币变化后多久才提示新装备,金币变化会提前于小兵金币获取收到
  iOpenInTrainScene 训练营是否开启 1开启，0不开启
  hashsetiValidModeIds 模式禁用,对应服务器ENPVPType
  -->
  <EquipmentGrowthConfig iSmallHeadDuration="2500" iSmallPreviewDuration="2000" iBigHeadDuration="5000" iBigPreviewDuration="3000" 
                         iGoldEffectInterval="0" iTimeSinceBattleStart="100" iNextEffectWaitTime="0" iAutoBuyDelay="5000"
                         sGoldGetEffectName="FX_UI_EquipmentGrowth_Gold_Refresh_add" iGoldGetEffectTime="2200" 
                         sGoldFlyEffectName="FX_UI_GoldAdd_Fly_add" iGoldFlyEffectTime="550"
                         sSmallPartGetEffectName="ui_EquipAdd_Fly" iSmallPartGetEffectTime="500"
                         sBigPartGetEffectName="FX_UI_EquipAdd_Fly_add" iBigPartGetEffectTime="500"
                         sBigPartRefreshEffectName="FX_UI_EquipmentGrowth_Refresh_add" iBigPartRefreshEffectTime="1800"
                         sGoldBeforeUpgradeEffectName="FX_UI_EquipmentGrowth_Gold_Refresh02_add" iGoldBeforeUpgradeEffectTime="400"
