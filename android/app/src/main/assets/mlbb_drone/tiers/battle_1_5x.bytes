<!--回城时消失：回城被打断时由于模型可能在摄像机外，如果是 CullUpdateTransforms 会导致动画状态卡住，
这里配置英雄列表在这些英雄回城被打断的情况下设置一段时间的 AlwaysAnimate  
fThreshold 不填的话默认就是 0.8 填的话就是由策划来控制百分比，0.5 就是百分之50, 0.9 就是 百分之90，动画超过百分之 80 才会触发 
加了正常结束时转成 landing-->
	<RecallBreakCulling sHeroList="4088;4;72;131;15;4015;22;23;25;51;85;86;96;105;106;108;111;124;125;126;77;52;62;133;26" fAlwaysTime="1" fThreshold=" "/>

	<XmlCustomFrameSetting>
		<!-- 自定义界面 
		iFrameID：界面ID，此ID需要从客户端程序那获取
		arraysHides：表示隐藏的界面节点路径数组
		arrayiHeroIds：表示只对哪些特定英雄应用这些设置
		XmlTransformConfig.sPath：Transform变换节点路径
		XmlTransformConfig.fOffsetX/fOffsetY：坐标相对偏移
		XmlTransformConfig.fScale：节点缩放
		XmlTransformConfig.fBoxSizeX/fBoxSizeY：点击响应范围
		XmlReplaceSprConfig.sFromSpr：节点原图集
		XmlReplaceSprConfig.sSpr：节点目标图集-->

		<!-- <XmlFrameConfig iFrameID="55" arrayiHeroIds="133"> -->
			<!-- <XmlTransformConfig sPath="m_BOTTON/m_SkilPos_3/m_SkillPosA_3" fOffsetX="15" fOffsetY="44"/> -->
			<!-- <XmlTransformConfig sPath="m_BOTTON/m_SkilPos_3/m_SkillPosB_3" fOffsetX="100" fOffsetY="65"/> -->
		<!-- </XmlFrameConfig> -->
	</XmlCustomFrameSetting>

		<!--133英雄按钮用
fComboSkillButtonOverlapRatio 按钮覆盖生效范围
iEnergyBuffId 需要监测的buffid
iRequiredEnergyForComboSkill 需要监测剩余的buff层数
iOverRangeReleaseTime 拖动施法后多长时间内触发过合成技能，则释放合成技能而非单体技能-->
	<Hero133Config fComboSkillButtonOverlapRatio="0.01" iEnergyBuffId="1338011" iRequiredEnergyForComboSkill="1" iOverRangeReleaseTime="500"/>

	<!-- 
  133英雄技能轮盘拖动变色功能 
  iCurveSmoothness 条带数量
  fCurvature  弧度与长度的比值
  fUnitLengthForTiling 疏密程度，0 表示不要设置tiling
  fNormalWidth 默认下的宽
  fDraggingWidth 手指按下时的宽
  uAvailableColor 底图默认颜色
  uUnavailableColor 不能使用时颜色
  uDraggingColor1 从1向2拖拽时颜色
  uDraggingColor2 从2向1拖拽时颜色
  Color编码格式：RGBA（32-bit）
  hashsetiKeepForHeroIds 对于这些hero不要删除curvelink GameObject（否则从UI KeySkill删除，以节省内存资源）
  -->

	<SkillButtonCurveLink iCurveSmoothness="20" fCurvature="0.3" fUnitLengthForTiling="0" 
		fNormalWidth="0.28" fDraggingWidth="0.28" 
		uAvailableColor="4294967244" uUnavailableColor="2358021260" uDraggingColor1="4294967295" uDraggingColor2="4294967295"
		hashsetiKeepForHeroIds="133"/>
		
	<!-- 锁敌视野回退技能白名单；逻辑层视野判定失败时，允许指定技能回退使用表现层视野再判一次!-->
	<LockSightFallbackSkills hashsetiSkillIDs="8900;2012801"/>
	
	<!-- 修复移动普攻英雄（艾蕊希尔），平A移动摇杆抬起的时候不会停止，配合Battle377开关555使用-->
	<FixMoveAtkNotStopConfig hashsetiHeroIDs="43"/>

