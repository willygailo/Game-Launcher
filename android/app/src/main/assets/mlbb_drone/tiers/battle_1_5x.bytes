  <!-- iKeepDistanceInSkillCD: 自动追击状态，在技能CD时，超过此距离（米*100，默认150）向目标移动 377-231活动开启才生效
	iChangeTargetWaitCoolDown: 表示自动切换目标时，等待技能冷却才继续追击。  1,仅目标死亡时等待 99,等待时不检测其他状态，自动切换即等待
	hashsetiIngoreCDHeros: 377的168配2, 142的633配880135;2 仅对此配置的英雄ID生效
	uIgnoreSmallCD: 377的168配3, 142的633配880135;3 技能当前CD<=配置的毫秒值时生效 -->
  <AutoAttackExtraConfig iKeepDistanceInSkillCD="150" iChangeTargetWaitCoolDown="1" hashsetiIngoreCDHeros="100" uIgnoreSmallCD="200" />

<!-- 

        //没有绑定的时候 呼叫玩家
        public static int m_CallDiDiMsgId = 0;
        // 强森开大过程中，队友发送快捷语会提示效果文本“强森正在开车中”
        public static int m_DiDiRuningMsgId = 0;
        // 绑定的时候 呼叫玩家
        public static int m_DiDiStartMsgId = 0;
        //对强森发出“请来接我”
        public static int CallDiDiStartMsgId = 0;

                        hashsetiMessgID   是否属于绑定消息监听的消息ID，这些消息才会启动强森交互 开启头像 和 绑定单位的信号ID
                        hashsetiNoOkHeroSignal  不需要谈OK 快捷回复的 英雄快捷语
						hashsetiLinkID         连接单位的快捷语消息
						hashsetiEggTriggerForbidID 屏蔽 彩蛋触发出来 快捷语
                        fShowDiDiButtonTime   头像下方的UI 显示时间
                        fShowDiDiButtonTime2   快捷按钮车车的 UI 显示时间
                        sCallDiDiStartAtlas    快捷按钮车车的 UI 显示atlas
                        sCallDiDiStartEffectName  队友发送 接我 小地图的特效显示
                        iCallDiDiFlyTip   - 强森开大过程中，队友发送快捷语会提示效果文本“强森正在开车中”
                        iCheckHeroSignalMessgID     队友发送快捷语会提示效果文本“强森正在开车中” 检测的快捷语ID

						没有绑定时候
						强森发送  iCallDiDiMsgId="20003"   
						别的单位点击OK
						hashsetiLinkID里面有 才会触发iCallDiDiStartMsgId="20006" “请来接我”	

                        -->

  <AShowDiDiData hashsetiHeroID="32" hashsetiMessgID="20001;20003;20004" hashsetiLinkID="20001" hashsetiNoOkHeroSignal="20001;20006;20004"
  hashsetiEggTriggerForbidID="3230"
  iCallDiDiMsgId="20003"
   iDiDiRuningMsgId="2" 
  iDiDiStartMsgId="20004"  iCallDiDiStartMsgId="20006" 
                                 fShowDiDiButtonTime="5000"  fShowDiDiButtonTime2="5000" 
                                 sCallDiDiStartAtlas=""  
                                 sCallDiDiStartEffectName="johnson_ui" 
                                 iCallDiDiFlyTip="60004"     
                                iCheckHeroSignalMessgID="20001"  sUIOkActionName = "Fx_ACT_UI_BattleChat_SendMessageFix" 

								/>
