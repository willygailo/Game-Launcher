  <!-- 配置筛选用 fLockDistance远启动距离下，启动距离 / fLockDistanceLimit近启动距离下，启动距离 / fCancelDistance红框消失距离，基本需要和远启动距离一致 / fAutoChangeTargetDistance击杀目标后，自动切目标的距离-->
  <VLockTarget fLockDistance="8" fLockDistanceLimit="5.7" fCancelDistance="8" fAutoChangeTargetDistance="3.5" fMonsterLockDistance="3" fLockHeroProtect="0" iLockFailTime="330" iLockFailAngle="15" iLockCatchMoveTime="198" fAroundDistance="8" fSkillLockProtectTime="1" sHeroKeep="xuanzhong_01" sBatmanKeep="xuanzhong_02" sSingleTargetKeep="yingxiong_touding" sMonsterAngryKeep="guaiwu_biaoji" fLockHeroProtectMin="5" fHeroDisProiBonus="0.5" hashsetiProtectNearCheckHeros="8;15;18;42;85;88;94;100;109;113" iHurtAndBeHurtValidTime="3000"/>
  
