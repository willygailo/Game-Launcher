  <!-- 转身平滑相关，iNewRotateAlgorithm配置1代表老的转身（转身角度逐渐衰减）
	iNewRotateAlgorithm配置2代表新的转身（转身角度平均分配，按照整体需要转的角度递增，iMaxDegrees最大角度 iMinDegrees最小角度 iMaxDegreesDelta最大角速度 iMinDegreesDelta最小角速度）-->
  <VSingleConfig fTurnSpeed="680" fArenaTurnSpeed="700" fPartyTurnSpeed="3800"  sReliveEffect="yingxiong_chusheng" fMotionBlending="0.15" fFootFlagPara="0.045" iAssistTime="12000" iKillProtectTime="10000" iSurvivalKillProtectTime="40000"
