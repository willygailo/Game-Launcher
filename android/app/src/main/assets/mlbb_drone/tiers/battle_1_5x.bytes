	<!-- 违规行为标签
		itime_in_same_area 记录坐标点的时间长度（单位毫秒）
		isame_area_dis 判定是否在同一区域的最小圆的半径（保留小数点后两位，乘以100）
		iFrendHeroDis 记录坐标点需要判定范围内是否有友方或敌方英雄，这个是范围值（保留小数点后两位，乘以100）
		iEnemyHeroDis 记录坐标点需要判定范围内是否有友方或敌方英雄，这个是范围值（保留小数点后两位，乘以100）
	-->
	<AMisconductLabelConfig iBattleTotalReportNum="100" iSinglePersonReportNum="30">
		<!-- 5v5排位/匹配/自定义 -->
		<MisconductPVPTypeConfig sPvptype="1;2;164;168" sLabelSort="1;2;5;3;6;4;7">
			<AJungleBuffGet imax_num="20" iCur_dead="1" itime="480000" imin_oppo_dis="800" imin_ally_dis="800" iget_buff="1" iJungleSkillID=""/>
			<AInterferenceBuff imax_num="20" imin_oppo_dis="800" imin_ally_dis="800" imin_friend_jungle_dis="800">
				<InterferenceBuffConditions icamp_id="1" fpos_x="0"/>
				<InterferenceBuffConditions icamp_id="2" fpos_x="0"/>
			</AInterferenceBuff>
			<ABadReturn imax_num="20" fhp_percent="0.7" fmana_percent="0.7" fxp_percent="0" fenergy_percent="0" iLastXSecondState="10000" Dict="BadReturnConditions.iHeroId">
				<BadReturnConditions iHeroId="17" fhp_percent="0.7" fmana_percent="0" fxp_percent="0.7" fenergy_percent="0"/>
			</ABadReturn>
			<ABadNoMove imin_interval="30000" itime_wait_judge="30000">
				<BadNoMoveConditions is_ingrass="0" itime_no_move="225" itime_no_atk="225" />
				<BadNoMoveConditions is_ingrass="1" itime_no_move="450" itime_no_atk="450" />
			</ABadNoMove>
			<AAfkAtSpring imin_interval="30000" itime_wait_judge="31000" iat_spring="1" itime_no_move="225" itime_no_atk="225" />
			<ABadWander imin_interval="30000" iLastNSecondsPos="15000" iFrendHeroDis="800" iEnemyHeroDis="800">
				<BadWanderConditions is_ingrass="0" itime_no_atk="225" itime_no_skill="225" itime_in_same_area="14850" isame_area_dis="750" imin_oppo_dis="800" imin_ally_dis="800" />
				<BadWanderConditions is_ingrass="1" itime_no_atk="450" itime_no_skill="450" itime_in_same_area="29700" isame_area_dis="750" imin_oppo_dis="800" imin_ally_dis="800" />
			</ABadWander>
		</MisconductPVPTypeConfig>
		<!-- 乱斗 -->
		<MisconductPVPTypeConfig sPvptype="4" sLabelSort="18;19;20">
			<ADisorderSpringAfk itime_wait_judge="31000" itime_at_spring="25000" fPosX="29.5"/>
			<ADisorderSecTowerAfk itime_wait_judge="31000" itime_at_sec_tower="25000" fPosX="20.1"/>
			<ADisorderAllTimeAfk itime_wait_judge="31000" itime_at_afk="40000"/>
		</MisconductPVPTypeConfig>
	</AMisconductLabelConfig>
	<!-- 违规行为评估器配置（新框架，对齐 LinuxCore 离线判罚；与 AMisconductLabelConfig 并存） -->
	<!-- LabelName 映射：1=feeding_dead(4001) 2=jungle_buff_get(6001) 3=bad_return(5003) 4=bad_no_move(5001) 5=interference_buff(6003) 6=afk_at_spring(5010)
	                     11=not_buy_equips(5011) 12=duplicate_equips(5007) 14=roam_no_shoes(6006) 15=jungle_no_shoes(6007) 16=jungle_no_hunting(6008) 17=carry_illegal_equips(5008)
	                     18=spring_afk 19=sec_tower_afk 20=all_time_afk 21=generic_afk -->
	<AMisconductEvaluatorConfig>
		<!-- 5v5排位/匹配/自定义 -->
		<MisconductEvaluatorPVPTypeConfig sPvptype="1;2;164;168" sLabelSort="1;2;5;3;6;4;11;12;17;14;16;15" isample_frame_limit="20" isample_frame_cd="450">
			<AFeedingDead ino_kill_time="5000"/>
			<ARoamNoShoes ijudge_time="35000"/>
			<AJungleNoShoes ijudge_time="95000"/>
			<AJungleNoHunting ijudge_time="180000"/>
			<!-- [已废弃] 5010 改由下方 AGenericAfk ilabel="6" 驱动）
			<AAfkAtSpring itime_wait_judge="31000" inum_highland_towers="1" itime_at_spring="25000"/>
			-->
			<AGenericAfk ilabel="6" itime_wait_judge="31000" itime_condition="25000" icd_group="1" iignore_damage="1" iignore_heal="1" iignore_kill_assist="1" iregion_all="0">
				<AfkCircleRegion fx1="-52" fy1="0" fradius="8.5" icamp="1"/>
				<AfkCircleRegion fx1="52" fy1="0" fradius="8.5" icamp="2"/>
				<AfkTowerCountGate iindex="3" imin_alive="1"/>
			</AGenericAfk>
			<AJungleBuffGet itime="300000" imin_oppo_dis="800"/>
			<AInterferenceBuff imin_oppo_dis="800" imin_ally_dis="800" ireport_frame_cd="45">
				<InterferenceBuffConditions icamp_id="1" fpos_x="0"/>
				<InterferenceBuffConditions icamp_id="2" fpos_x="0"/>
			</AInterferenceBuff>
			<ABadReturn fhp_percent="0.7" fmana_percent="0.7" fxp_percent="0" fenergy_percent="0" itime_before_locked="2000" Dict="BadReturnConditions.iHeroId">
				<BadReturnConditions iHeroId="17" fhp_percent="0.7" fmana_percent="0" fxp_percent="0.7" fenergy_percent="0"/>
			</ABadReturn>
			<ABadNoMove itime_wait_judge="31000">
				<BadNoMoveConditions is_ingrass="0" itime_no_move="25000" itime_no_atk="25000" />
				<BadNoMoveConditions is_ingrass="1" itime_no_move="40000" itime_no_atk="40000" />
			</ABadNoMove>
			<ADuplicateEquips sspecial_equips="3008;3102"/>
			<ANotBuyEquips idelay_judge_time="40000" igold_thold_spare="2500" igold_thold_not_final="3500"/>
			<ACarryIllegalEquips arrayiexclude_heroids="" arrayiexclude_equipids="2107;3207;10001;10003"/>
		</MisconductEvaluatorPVPTypeConfig>
		<!-- 乱斗 -->
		<MisconductEvaluatorPVPTypeConfig sPvptype="4" sLabelSort="18;19;20" isample_frame_limit="20" isample_frame_cd="450">
			<!-- [已废弃] 5015/5016 改由下方 AGenericAfk ilabel="18"/"19" 驱动）
			<ADisorderSpringAfk itime_wait_judge="31000" itime_at_spring="25000" fPosX="29.5"/>
			<ADisorderSecTowerAfk itime_wait_judge="31000" itime_at_sec_tower="25000" fPosX="20.1"/>
			-->
			<ADisorderAllTimeAfk itime_wait_judge="31000" itime_at_afk="40000"/>
			<!-- 5015 乱斗泉水挂机（通用挂机驱动）：要求二塔存活(iindex=3)且一塔已掉(iindex=2)，区域=己方水晶前沿后方半平面(旧 fPosX=29.5)
			     iignore_kill_assist="1"：旧逻辑只判无伤害+治疗窗口，不判击杀助攻窗口
			     icd_group="2" = disorder 共享 CD 组（与 5016/5017 同锚点，单位帧） -->
			<AGenericAfk ilabel="18" itime_wait_judge="31000" itime_condition="25000" icd_group="2" iignore_damage="0" iignore_heal="0" iignore_kill_assist="1" iregion_all="0">
				<AfkBoxRegion fx1="-10000" fy1="-10000" fx2="-29.5" fy2="10000" icamp="1"/>
				<AfkBoxRegion fx1="29.5" fy1="-10000" fx2="10000" fy2="10000" icamp="2"/>
				<AfkTowerAliveGate iroad="3" iindex="3" ineed_alive="1"/>
				<AfkTowerAliveGate iroad="3" iindex="2" ineed_alive="0"/>
			</AGenericAfk>
			<!-- 5016 乱斗二塔挂机（通用挂机驱动）：要求一塔、二塔都存活（与 5015 互斥），区域=己方二塔前沿后方半平面(旧 fPosX=20.1) -->
			<AGenericAfk ilabel="19" itime_wait_judge="31000" itime_condition="25000" icd_group="2" iignore_damage="0" iignore_heal="0" iignore_kill_assist="1" iregion_all="0">
				<AfkBoxRegion fx1="-10000" fy1="-10000" fx2="-20.1" fy2="10000" icamp="1"/>
				<AfkBoxRegion fx1="20.1" fy1="-10000" fx2="10000" fy2="10000" icamp="2"/>
				<AfkTowerAliveGate iroad="3" iindex="3" ineed_alive="1"/>
				<AfkTowerAliveGate iroad="3" iindex="2" ineed_alive="1"/>
			</AGenericAfk>
		</MisconductEvaluatorPVPTypeConfig>
		<!-- 通用挂机 AGenericAfk 参考模板（一个 PVPTypeConfig 可配多条，每条一个 ilabel，各自独立计时）
		     ilabel               该条以哪个 LabelName 上报: 6=5010 18=5015 19=5016 20=5017 21=全新模式(需服务端先认 21)
		     itime_wait_judge     开局延迟门限(ms)，换算成帧后与 curFrame 比较
		     itime_condition      连续满足条件的命中阈值(ms)；也是治疗/击杀助攻窗口的长度
		     icd_group            去重CD组: 0=本 label 独立(ms) 1=AFK共享组(与5001/5003共享,ms) 2=disorder共享组(与5017共享,帧)
		     iignore_damage       1=不判"本帧未对敌造成伤害"    0=判(默认/严)
		     iignore_heal         1=不判"窗口内未对己方治疗"    0=判(默认/严)
		     iignore_kill_assist  1=不判"窗口内无击杀助攻"      0=判(默认/严)
		                          注意 iignore_* 缺省为 0(=检查)，漏写只会更严(漏判)，不会更松(误判)
		     iregion_all          1=不限区域(全图)；0 时必须至少配一个区域节点，否则该条恒不满足
		     区域节点(并集，任一命中即算在区域内)：
		           AfkCircleRegion    fx1,fy1=圆心 fradius=半径(米)，比较用严格 dis²<r²
		           AfkBoxRegion       fx1,fy1~fx2,fy2=矩形对角(米,闭区间)，半平面把一条边取很大即可等价表达
		           icamp 阵营过滤: 0=全部玩家 1=仅A阵营(负x侧) 2=仅B阵营(正x侧)；对称模式写两条分属A/B，非对称按需写一条或 icamp=0
		     塔门节点(交集，全部通过才算满足)：
		           AfkTowerAliveGate  iroad(1=上 2=中 3=下) iindex(塔序号,乱斗 2=一塔 3=二塔; 5v5 3=高地塔) ineed_alive(1=需存活 0=需已掉)
		           AfkTowerCountGate  iindex=塔序号，imin_alive=该序号塔在上/中/下三路的存活数下限 -->
		<MisconductEvaluatorPVPTypeConfig sPvptype="0" sLabelSort="21" isample_frame_limit="20" isample_frame_cd="450">
			<AGenericAfk ilabel="21" itime_wait_judge="31000" itime_condition="25000" icd_group="0" iignore_damage="0" iignore_heal="0" iignore_kill_assist="0" iregion_all="0">
				<!-- 泉水圆形区(A/B 各一条) + 矩形区(可混配,并集) + 塔门(可选,多条 AND) -->
				<AfkCircleRegion fx1="-48" fy1="0" fradius="9" icamp="1"/>
				<AfkCircleRegion fx1="48" fy1="0" fradius="9" icamp="2"/>
				<AfkBoxRegion fx1="-1000" fy1="-1000" fx2="-29.5" fy2="1000" icamp="1"/>
				<AfkBoxRegion fx1="29.5" fy1="-1000" fx2="1000" fy2="1000" icamp="2"/>
			</AGenericAfk>
		</MisconductEvaluatorPVPTypeConfig>
	</AMisconductEvaluatorConfig>
		<!-- 抱摔 专用 配置动画
			sPlayName  裁剪动画名
			fStartTime   动画 播放的 起始时间
			fCrossTime   动画 播放的 融合时间
			fDurationTime  动画 播放的 持续时间
			iStopAnima   是否中断其他动画
			iEndStopType  时间结束后 停止类型 1是停止当前播放的动画状态 速度为0
		-->
	<APlayAnimaBaoshuai Dict="ABaoshuaiData.iHeroID" >
		<ABaoshuaiData iHeroID="140" iType="1" sPlayName="dead" fStartTime="0.4" fCrossTime="0.1" fDurationTime="0.1" iStopAnima="1" iEndStopType="1" />
	</APlayAnimaBaoshuai>

