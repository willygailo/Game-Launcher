        <MapArray iIndex="2" sMaps ="9;14;16;19;33;34;35;36" /> <!--帝国圣域-->	
        <MapArray iIndex="3" sMaps ="2" /> <!--西部荒漠-->		
        <MapArray iIndex="4" sMaps ="32" /> <!--狂欢节地图-->		
        <MapArray iIndex="5" sMaps ="2;9;14;16;19;33;34;35;36" /> <!--帝国圣域+西部荒漠-->		
        <MapArray iIndex="6" sMaps ="10;12;13;15;20;21;22;23;24;37;40;41;42;51;52;53;54;55;56;57;58" /> <!--与1一样去除足球地图-->	
