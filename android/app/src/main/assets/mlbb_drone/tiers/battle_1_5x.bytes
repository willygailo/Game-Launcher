  <!--SimulateBattle下的配置集合-->
  <SimulateBattleParam iDefaultNextBattlePlayMode="4"/>


  <!--
  iDmgRatioSwitch 1 采用新算法
  if （目标初始抗性 >= 0)，then 减免后抗性 = 目标初始抗性 * （1 - 攻击者百分比穿透） - 攻击者固定值穿透
  else if（目标初始抗性 < 0), then 减免后抗性 = 目标初始抗性 - 攻击者固定值穿透
  伤害减免公式 DIV(fDefPara, (Defence + fDefPara)) 
  iAttrIndexAddSwitch 公式在Get AttrIndexAdd的时候需要乘以1+ATTR_INDEX_ALL_PERCENT这个系数
  fPhyDefMin 物防下限，因为穿透的存在所以可以为负值，指上面Defence的位置
  fMagDefMin 魔防下限，因为穿透的存在所以可以为负值，指上面Defence的位置
  fDefPara 见伤害减免公式
  fNonHeroStlRatio 对非英雄单位做总的吸血的百分比调整,ATTR_KIND_HEAL
  fNonHeroSkillSorb 对非英雄单位【技能吸血】的百分比调整系数 ATTR_KIND_COMM_SKILL_SORB = 62,
  fNonHeroPhySorb 对非英雄单位【物理吸血】的百分比调整系数 ATTR_KIND_COMM_ATTACK_SORB = 39
  fNonHeroMagSorb 对非英雄单位【魔法吸血】的百分比调整系数 ATTR_KIND_SPELL_SORB = 40
  
  iAbsorbShieldSwitch 填护盾ID开启可以对护盾吸血，中间用;间隔
  -->
  <SkillFormula iDmgRatioSwitch="1" iAttrIndexAddSwitch="1" fPhyDefMin="-60" fMagDefMin="-60" fDefPara="120" fNonHeroStlRatio="1" fNonHeroSkillSorbRatio="1" fNonHeroPhySorbRatio="1" fNonHeroMagSorbRatio="1" iAbsorbShieldSwitch="1" hashsetiAdaptAttr="81;82;83;84" hashsetiAbsorbShieldSwitch="114;144"/>
  <!--
    获取属性后再修改值（属性非负相关）
    GetAttrModsItem.iId ATTR_KIND
    GetAttrModsItemIdx.iIndex ATTR_INDEX
    iCond
      1:Negative = 1,//值是负数
      2:SrcSkillIsNotAtk = 2,//非普攻
    iFunc
      1:DivAttrIndex3 = 1,//CalculateResult不乘以(1d + allPer)
      2:Value = 2,//用iP1赋值
      3:RogueMoba = 3,//[iId][iIndex]*iP1/100 + [iP2][iP3]*iP4/100
    -->
  <GetAttrMods Dict="GetAttrModsItem.iId">
    <GetAttrModsItem iId="106" >
      <GetAttrModsItemIdx iIndex="5" iCond="1" iFunc="1"/>
    </GetAttrModsItem>
    <GetAttrModsItem iId="107" >
      <GetAttrModsItemIdx iIndex="5" iCond="1" iFunc="1"/>
    </GetAttrModsItem>
    <GetAttrModsItem iId="102" >
      <GetAttrModsItemIdx iIndex="5" iCond="1" iFunc="2" iP1="0"/>
    </GetAttrModsItem>
    <GetAttrModsItem iId="103" >
      <GetAttrModsItemIdx iIndex="5" iCond="1" iFunc="2" iP1="0"/>
    </GetAttrModsItem>
  </GetAttrMods>
