  <!-- 技能释放范围控制sprite的localPos(x,y)  1,2,3 主要技能 4,5,6辅助技能    
    fSkillRangeScale为技能轮盘缩放范围值，fSkillRangeScaleMax为技能轮盘缩放大小，
	hashsetiExcludShowRectPara为skill.ShowRectPara参数0下，哪些不被技能轮盘缩放影响 -->
  <ABattleSkillRangeControlPos sSkill1Pos="0,38" sSkill2Pos="0,0" sSkill3Pos="-32,0" sSkill4Pos="0,56" sSkill5Pos="0,56" sSkill6Pos="0,56" sSkill7Pos="0,60" sSkill8Pos="0,0" sSkill9Pos="0,0" sSkill10Pos="-62,0" sSkill11Pos="0,0" sSkill12Pos="0,56" fSkillRangeScale="6" fSkillRangeScaleMax="1.3" hashsetiShowRectPara="3;8;9">
  </ABattleSkillRangeControlPos>

  <!--dDisRatio 延长距离，dMinPer 最小速度百分比，dMaxPer 最大速度百分比， fSpeed 最大速度,   dSpeedChange整体速度-->
  <AQuickMoveData dDisRatio="1.15" dMinPer="0.8" dMaxPer="2" dMaxSpeed="20" dSpeedChange="1.5" />

  <!-- 乱斗模式开局提示（泉水不能购买装备）, fStartShowTime 乱斗模式战斗开始后多久显示 提示 (单位s)，  fShowTime 乱斗模式 提示显示持续多久 (单位s) -->
  <ABattleModeTip fStartShowTime="1" fShowTime="5"/>

  <!-- 新账号 前N(iCount)局玩家打掉防御塔之后地面出现箭头引导 ,持续几秒(fShowTime)-->
  <ANeedGuidArrowAfterTowerDestory iCount="0" fShowTime="10"/>
  <!-- 新账号 前N(iCount)局玩家进入塔红圈被打循环提示-->
  <ANeedLoopSoundAttakedByTower iBattleCount="888" />
  <!-- 温暖关防止基地被ai推掉 的保护技能 -->
  <AWarmBattleSkillConfig iSelfSkill="31400" iEnimyTowerSkill="31301" iSelfSkillByRobotAndWarm="40044" iSelfMainTowerSkillByWarm="0" iEnemyTowerSkillByWarm="0" fLineRange="-6"/>
  <!-- 引导第2  多长时间没有操作遥感关提示 (单位秒s)-->
  <!-- <AJoyStickTip iNoneOperateTime="30" /> -->
  <!-- 普攻 和 技能 弱引导提示 时间(s)    iAtkGuideTimeAfterJoystick  遥感操作完成后多久后才能触发 攻击引导（s）-->
  <ASkillWeakGuide iNormalAtkNoUseTime="60" iSkillNoUseTime="100" iAtkGuideTimeAfterJoystick="20" /> 
  <!-- 引导第二关，血条显示警告的 血量百分比-->
  <AGuideBloodBarWarning iBloodPercent="30" fKeepTime="2.0" />
