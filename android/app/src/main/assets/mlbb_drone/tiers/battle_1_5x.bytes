  <!-- 英雄死亡删除的召唤物 -->
  <AHeroDieHideSummons hashsetiSummons=""/>

  <!-- 限制每个攻击者短时间内产生的效果次数限制
iSourceType：来源类型。
    1 = Skill，按技能 ID 控制，SNeedControl.iControlID 填 SkillID
    2 = Effect，按特效表 ID 控制，SNeedControl.iControlID 填 EffectID
    3 = Bullet，按子弹表 ID 控制，SNeedControl.iControlID 填 BulletID
Dict="SNeedControl.iControlID"：内层字典 key，同一个来源类型下按具体 ID 查找配置。
iControlID：控制 ID，含义由 iSourceType 决定。
iProtectLv：保护等级。
    0 = 普通表现，可被限频，也可被数量上限裁剪
    1 = 重要表现，不走创建前限频；数量超限时优先保留，普通表现不够裁时才裁
    2 = 关键表现，不走创建前限频，也不会被数量上限裁剪
  ,iIntervalTime间隔时间单位是毫秒
  ,iType类型 屏蔽对这种目标的特效创建 使用二进制值（0，全类型创建 2进制第0位，英雄 2进制第1位，小兵
          0：不屏蔽任何特效
          1：攻击者/受击者是英雄，屏蔽特效
          2：攻击者/受击者是小兵，屏蔽特效
          3：屏蔽全部特效
  ,iCheckTarget，填 1 表示检查目标，而不是自身
  ,iPerfLvFilter画质 使用二进制值，值对应1(极简)+2(低)+4(中)+8(高)+16(极高)。不填或填0代表全画质可用。 
  ,iLimitTimes极限数量(0为无限制)，
  ,iMergeIntervalTime 合并刷新窗口，单位毫秒；0 表示不合并。
  ,iMergeType 合并方式：0 不合并，1 Refresh 刷新已有受击特效；当前版本不支持 Level-Up。
-->
  <ANeedControlEffect_ForAttack Dict="EffectNeedControl.iSourceType">
    <EffectNeedControl iSourceType="2" Dict="SNeedControl.iControlID" >
