  <ResAlternativeByTargetSkin sList="BlackDragon_beidong_huifu;BlackDragon_beidong_bullet;Play_1951_passive_02;walundina_skill3_bullet;walundina_skill03_hit_02"/>
  
  <!--
  挫败温暖关配置
  sDiffs 深度学习AI难度列表
  iKillScoreLimit 人头差分数上限
  iGoldScoreLimit 经济差分数上限
  iTowerScoreLimit 防御塔差 分数上限
  iBossScoreLimit  己方是否有领主在场上 分数上限
  iAliveScoreLimit 己方当前存活英雄数 分数上限
  iKillScoreRate  人头差分率
  iGoldScoreRate  经济差分率  单位：万分比
  iTowerScoreRate 防御塔差分率
  iBossScoreRate  己方是否有领主在场上分率
  iAliveScoreRate 己方当前存活英雄数分率
  iKillWeight     人头差权重                 单位：万分比
  iGoldWeight     经济差权重                 单位：万分比
  iTowerWeight    防御塔差权重               单位：万分比
  iBossWeight     己方是否有领主在场上权重   单位：万分比
  iAliveWeight    己方当前存活ut数权重     单位：万分比
  iLargeExceedRate 大优的分数比率            单位：万分比
  iSituationMin   玩家劣势条件   单位：万分比
  iSituationMax   玩家优势条件   单位：万分比
  iRobotExceedTimes 升级玩家AI难度，机器人优势的次数
  iLargeExceedTimes 升级机器人AI难度，玩家大优的次数
  iInternal    分析战场形势间隔时间，单位：毫秒！！！！！！！绝对不能配错，配错可以辞职。
  iEnemyDifUpLimitTime  敌方AI难度提升的时间限制，战斗时长超过该值后，难度不再提升  单位：毫秒
  iLargeExceedForMVP 玩家方机器人降难度条件  单位：万分比
  iScoreMarginForMVP 玩家最高分与机器人最高分之间的分数差距  保留小数点后两位（百分比）
  
  sNeedSkills    需要落进数据和上报到状态数据里的技能ID
  hashsetiDynamicDifRealPVPType 开启动态难度的realpvptype，里面必须是一方全是机器人 
  iMinimumTree 深度ai失败后保底行为树，1开0关
  hashsetiQuitSkillUIkeyType 主视角深度AI下不处理SkillUIkey的逻辑，填SkillUIkeyType.ikeyType
  -->
  <AMLLibAIDifficulty sDiffs="40;50;80;100;150" iKillScoreRate="500" iKillScoreLimit="10000" iKillWeight="4000" iGoldScoreRate="5000" iGoldScoreLimit="10000" iGoldWeight="1500" iTowerScoreRate="1000" iTowerWeight="1500" iTowerScoreLimit="10000" iBossScoreRate="5000" iBossWeight="2000" iBossScoreLimit="10000" iAliveScoreRate="1000" iAliveWeight="1000" iAliveScoreLimit="10000" iLargeExceedRate="13000" iSituationMin="9000" iSituationMax="10001" iInternal="20000" iRobotExceedTimes="2" iLargeExceedTimes="4" hashsetiNeedSkills="1338011;1080053;220;636;4931;3421;1931;1932;1933;2030;2330;2320;2321;3220;4422;4637;4922;7750;8030;8331;8914;9138;113000;113004;966200;442200;64200;64300;1004000;994000;993402;1074100;1074103;6732;84100;1721;1723;172000;8950;8951;204100;202100;215000;244026;1014100;300005;644000;641000;640004;2802000;2802002;25073;25065;1039000;525000;1094000;133400;20133400;6114001;603003;603001;634000;1044000;1182403;962600;1212099;430;1830;930;6670;6680;101933;6530;6871;8916;3651;3630;11761;11911;11923;12316;229000;220100;515805;690200;4511;6620;6680;6687;6639;6710;7081;107104;207105;713043;8239;823800;8310;8531;853200;9020;9511;10170;10432;12532;12920;2012928;1293005;2401100;2404100;909000000;2402100;2400100;2410100;2408500;2403100;909001400;2494000;2496400;2411300;2497400;2499600;2467500;2492000;2485400;2485800;2414100;226002;226011;36406;230;311;511;611;612;613;2822;3028;3017;3730;3731;3752;3820;3917;4610;4620;4722;4742;5020;5035;5031;5032;5210;5211;5416;5510;5610;5810;6211;6424;106965;6952;7120;7315;7351;731006;731007;742130;773012;7952;8210;843001;8511;8512;8513;8610;8611;8622;933000;9520;9620;209720;9919;9920;2010557;3010570;10612;10622;10711;1112007;11111;11210;11510;11624;11847;12030;12122;2012235;12654;12738;1282024;12913;12917;12918;13235" hashsetiBlackListSkills="273502;10460;1046000;508009;10174;10175;1213015" iEnemyDifUpLimitTime="720000" iLargeExceedForMVP="11000" iScoreMarginForMVP="150" hashsetiDynamicDifRealPVPType="51;57" iMinimumTree="1" hashs