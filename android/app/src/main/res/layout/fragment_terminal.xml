<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_terminal_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ SHIZUKU TERMINAL"
                android:textColor="#00FF9C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tv_shizuku_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚫ Checking Shizuku status..."
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingTop="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_clear_output"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="CLEAR"
            android:textSize="11sp"
            android:backgroundTint="#1A0000"
            android:strokeColor="#FF4040"
            android:strokeWidth="1"
            android:textColor="#FF4040"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
    </LinearLayout>

    <!-- Terminal Log Output Area -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CONSOLE OUTPUT:"
        android:textColor="#555566"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:paddingBottom="4dp" />

    <ScrollView
        android:id="@+id/sv_terminal_output"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_glass_shape"
        android:padding="2dp">

        <TextView
            android:id="@+id/tv_terminal_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[GameBooster Terminal] Shizuku ADB shell active. Type a command below.\n"
            android:textColor="#00FF9C"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- Command Prompt Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COMMAND PROMPT:"
        android:textColor="#555566"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_command_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_command_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. getprop ro.build.version.release"
                android:textColor="#CCCCDD"
                android:textColorHint="#555566"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_run_command"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="EXEC"
            android:textColor="#00FF9C"
            android:backgroundTint="#0D2B0D"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:strokeColor="#00FF9C"
            android:strokeWidth="1" />
    </LinearLayout>

    <!-- Info Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ℹ️  Shizuku ADB shell active. Enter any shell command to execute with granted permissions."
        android:textColor="#444455"
        android:textSize="10sp"
        android:paddingTop="6dp" />

</LinearLayout>
