<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hud_root_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#DD121212">

    <Button
        android:id="@+id/btn_hud_resync_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ Re-Sync Map"
        android:textSize="12sp"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btn_hud_165fps_hdr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎯 PUBGM 165 FPS + HDR"
        android:textSize="12sp"
        android:textColor="#FFD700" />

    <Button
        android:id="@+id/btn_hud_force_185"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚀 Force 185 FPS"
        android:textSize="12sp"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btn_hud_flush_vulkan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🧹 Flush Vulkan"
        android:textSize="12sp"
        android:textColor="#FFFFFF" />

</LinearLayout>
