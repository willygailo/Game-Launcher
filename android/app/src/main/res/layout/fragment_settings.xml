<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image (omni.jpeg) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/omni"
        android:scaleType="centerCrop"
        android:contentDescription="Settings Background" />

    <!-- Translucent glass scrim overlay (Crystal Glassmorphism) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55080B12" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="36dp"
            android:paddingBottom="16dp">

            <!-- HEADER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ DASHBOARD SETTINGS &amp; TWEAKS"
                android:textColor="@color/accent_cyan"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Shizuku privileged shell, hardware engines, &amp; system tweaks"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- CARD 1: SHIZUKU ADB & PRIVILEGED PERMISSIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_glass_shape"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 SHIZUKU ADB &amp; SYSTEM PERMISSIONS"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />

                <TextView
                    android:id="@+id/tv_engine_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Active Engine: Checking..."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_storage_access_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="📁 Shizuku File &amp; Data Control: Checking..."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_grant_shizuku"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/btn_cyber_cyan"
                        android:padding="0dp"
                        android:text="⚡ 1-TAP ALL PERMISSIONS"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_grant_storage_access"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/btn_cyber_dark"
                        android:padding="0dp"
                        android:text="📁 UNLOCK GAME DATA"
                        android:textColor="@color/accent_neon_green"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>


            <!-- CARD 2: ESPORTS GAMING CONTROLS & JANK PURGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_glass_shape"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮 ESPORTS GAMING CONTROLS"
                    android:textColor="@color/accent_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />

                <Switch
                    android:id="@+id/switch_overlay_hud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Floating Performance Overlay HUD"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switch_gaming_dnd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Gaming DND &amp; Banner Blocker"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switch_auto_game_boost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Auto Game Launch Detection &amp; Boost"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switch_esports_audio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Esports Footstep Audio Boost (2kHz-4kHz)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_clean_game_caches"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_cyber_dark"
                    android:text="🧹 PURGE JANK &amp; CLEAR ALL CACHES"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- CARD 2.5: PRECISION AIM - INPUT & GYRO TUNER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_glass_shape"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 PRECISION AIM – INPUT &amp; GYRO TUNER"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />

                <TextView
                    android:id="@+id/tv_precision_aim_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Status: Device Input Stock / Default"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/switch_precision_input_tuner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Shizuku 1000Hz Polling &amp; Zero Touch Slop"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switch_crosshair_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Hardware Crosshair Target Overlay"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_crosshair_preset"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/btn_cyber_dark"
                        android:text="🎯 CROSSHAIR PRESETS"
                        android:textColor="@color/accent_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_sensitivity_calculator"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/btn_cyber_dark"
                        android:text="🧮 SENSITIVITY CALCULATOR"
                        android:textColor="@color/accent_neon_green"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD 3: HARDWARE & DRIVER ENGINES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_glass_shape"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ HARDWARE &amp; DRIVER ENGINES"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />

                <Switch
                    android:id="@+id/switch_angle_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Google ANGLE Vulkan Driver (OpenGL ES to Vulkan)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switch_game_driver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="System Game Driver for All Games"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switch_gpu_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="GPU Vulkan 3D HWUI Renderer"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switch_cpu_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="CPU Extreme Performance Governor"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- CARD 4: NETWORK & LATENCY OPTIMIZATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_glass_shape"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 NETWORK &amp; LATENCY OPTIMIZATION"
                    android:textColor="@color/accent_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />

                <!-- Network Mode Title & Status Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Gaming Acceleration Mode:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 3-Way Mode Selector: Dual / 5G-6G / Wi-Fi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_mode_dual"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/btn_cyber_cyan"
                        android:padding="0dp"
                        android:text="⚡ DUAL ACCEL\n(DATA + WI-FI)"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_mode_5g_6g"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/btn_cyber_dark"
                        android:padding="0dp"
                        android:text="📶 5G / 6G\nDATA ONLY"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_mode_wifi"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/btn_cyber_dark"
                        android:padding="0dp"
                        android:text="🌐 WI-FI\nLOW-LATENCY"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_active_network_mode_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="⚡ Active Mode: DUAL ACCELERATION (DATA + WI-FI)"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Game Server Ping Tester -->
                <TextView
                    android:id="@+id/tv_game_ping_ms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="📡 Game Server Ping: Ready to test"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_ping_test"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_cyber_dark"
                    android:text="📡 TEST GAME SERVER LATENCY"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- 1-Tap Gaming DNS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="1-Tap Gaming DNS Latency Booster:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_dns_cloudflare"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/btn_cyber_cyan"
                        android:padding="0dp"
                        android:text="⚡ 1.1.1.1"
                        android:textColor="#000000"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_dns_google"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/btn_cyber_dark"
                        android:padding="0dp"
                        android:text="🌐 8.8.8.8"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_dns_default"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/btn_cyber_dark"
                        android:padding="0dp"
                        android:text="🔄 DEFAULT"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Network Optimization Toggles -->
                <Switch
                    android:id="@+id/switch_dual_data_wifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Dual Channel Concurrent Acceleration (Data + Wi-Fi)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switch_5g_6g_boost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="5G / 6G NR SA/NSA Low-Latency Band Prioritization"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switch_wifi_low_latency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Wi-Fi 6E/7 Low-Latency Chip Mode &amp; 0ms Sleep"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switch_tethering_hw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tethering Hardware Acceleration (Hotspot Offload)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/switch_force_gnss"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Force Full GNSS Raw Measurements"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- CARD 5: ADVANCED SYSTEM TWEAKS ENGINE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_glass_shape"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛠️ ADVANCED SYSTEM TWEAKS ENGINE"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />

                <TextView
                    android:id="@+id/tv_tweaks_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="System Engine: Active"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Disconnect Alert Banner -->
                <LinearLayout
                    android:id="@+id/banner_shizuku_disconnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#40FF0055"
                    android:padding="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Shizuku Binder Disconnected. Reconnect Shizuku to apply system tweaks."
                        android:textColor="#FF8888"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Search Bar for Tweaks & Games -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/search_bar_cyber_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_search_tweaks"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:hint="Search tweaks, games (MLBB, PUBG, 120/144/165/185 FPS, Vulkan)..."
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="11sp"
                        android:inputType="text"
                        android:maxLines="1"
                        android:imeOptions="actionSearch" />

                    <ImageView
                        android:id="@+id/iv_clear_search"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="@color/accent_cyan"
                        android:contentDescription="Clear Search"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Tweak Filter Buttons -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_filter_all"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="ALL"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_filter_cpugpu"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="CPU/GPU"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_filter_touch"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="TOUCH"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_filter_shizuku"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="SHIZUKU"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btn_filter_network"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="NETWORK"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_tweaks_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- CARD SPOOF: HARDWARE DEVICE SPOOFING -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_glass_shape"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎭 HARDWARE DEVICE SPOOFING"
                    android:textColor="@color/accent_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Spoof model, brand, vendor &amp; SoC identity via Shizuku temporary root access."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Switch
                        android:id="@+id/switch_device_spoof"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Enable Device Spoofing"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
