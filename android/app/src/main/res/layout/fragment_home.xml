<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:clipToPadding="false"
    android:scrollbars="vertical"
    android:scrollbarThumbVertical="@drawable/badge_neon_cyan"
    android:paddingBottom="120dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Top Header: Title, Live Pulse Dot, & Settings Shortcut -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/badge_neon_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GAME BOOSTER PRO"
                        android:textColor="@color/accent_cyan"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="120 • 144 • 165 • 185 FPS Extreme Gaming Engine"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_open_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_cyber_dark"
                android:padding="0dp"
                android:text="⚙️"
                android:textSize="18sp" />
        </RelativeLayout>

        <!-- Live Telemetry Strip: Dual Glass Chips (Engine Mode + RAM Usage) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <!-- Engine Mode Chip -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/card_glass_shape"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM ENGINE"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tv_engine_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="⚡ SHIZUKU ACTIVE"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Memory RAM Chip -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/card_glass_shape"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEVICE MEMORY"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tv_ram_usage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="RAM: —"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dedicated Chipset Turbo & OEM Bypass Hub Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/card_glass_shape"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ CHIPSET &amp; OEM ENGINE"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tv_chipset_oem_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_neon_cyan"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="TURBO ACTIVE"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_soc_detected_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Detecting Processor SoC..."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_oem_bypass_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Legal OEM Throttling Bypass Active"
                android:textColor="@color/accent_neon_green"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_dexopt_speed_compile"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_cyber_dark"
                android:text="⚡ AOT Speed Compile (Zero In-Game JIT Stutter)"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 1-TAP TARGET RATE & FPS UNLOCK (120Hz / 144Hz / 165Hz) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_glass_shape"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎯 TARGET RATE &amp; FPS UNLOCK"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tv_home_target_hz_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_neon_green"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="165Hz ACTIVE"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_home_target_120"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/btn_cyber_dark"
                    android:padding="0dp"
                    android:text="⚡ 120\nFPS/Hz"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_home_target_144"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/btn_cyber_dark"
                    android:padding="0dp"
                    android:text="🎮 144\nFPS/Hz"
                    android:textColor="@color/accent_cyan"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_home_target_165"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/btn_cyber_dark"
                    android:padding="0dp"
                    android:text="🔥 165\nFPS/Hz"
                    android:textColor="@color/accent_cyan"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_home_target_185"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/btn_cyber_cyan"
                    android:padding="0dp"
                    android:text="🚀 185\nFPS/Hz"
                    android:textColor="#000000"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Featured Hero Hardware Banner Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#00000000">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_glass_shape">

                <ImageView
                    android:id="@+id/iv_hero_banner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/hero_banner"
                    android:contentDescription="Hero banner" />

                <!-- Translucent cyber gradient scrim -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#40060911" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentStart="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚀 EXTREME HARDWARE ENGINE"
                        android:textColor="@color/accent_cyan"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:shadowColor="#EE000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="120 / 144 / 165 / 185 FPS Unlocked • Zero Throttling"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:shadowColor="#EE000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="12dp"
                    android:background="@drawable/badge_neon_green"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="ACTIVE"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Games Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_games_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SUPPORTED GAMES (0 DETECTED)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Games RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_games_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false" />

        <!-- Empty State (Shown when no target games detected) -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_glass_shape"
            android:paddingHorizontal="20dp"
            android:paddingVertical="40dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯"
                android:textSize="48sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No Target Games Detected"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Install MLBB, PUBG, CODM, Free Fire, Genshin, HOK, Roblox, Valorant, or Farlight\nand they will appear here with 1-Tap 120/144/165/185 FPS Turbo Boost."
                android:textColor="@color/empty_state_text"
                android:textSize="12sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
