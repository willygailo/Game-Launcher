<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row: Title + Settings Icon -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ GAME BOOSTER PRO"
                    android:textColor="@color/accent_cyan"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:shadowColor="#8000F0FF"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="MLBB • PUBGM • CODM • HOK • Blood Strike"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_open_settings"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/card_neon_glow"
                android:padding="0dp"
                android:text="⚙️"
                android:textSize="22sp" />
        </RelativeLayout>

        <!-- Compact Status Strip: Engine mode + RAM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_neon_glow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tv_engine_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ SHIZUKU BINDER ACTIVE"
                android:textColor="@color/accent_neon_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tv_ram_usage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAM: —"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Featured Hero Banner Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#00000000">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_neon_glow">

                <ImageView
                    android:id="@+id/iv_hero_banner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/hero_banner"
                    android:contentDescription="Hero banner" />

                <!-- Translucent overlay for high text contrast -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#35071022" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentStart="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚀 EXTREME HARDWARE SPOOFER"
                        android:textColor="@color/accent_cyan"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="165Hz Display • ROG 8 Pro Profile • Esports DNS"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="6" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="12dp"
                    android:background="@drawable/hero_glass_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="24/7 AUTO BOOST"
                    android:textColor="#0B0E14"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Games Count Header + Add Game Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_games_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="INSTALLED TARGET GAMES"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <Button
                android:id="@+id/btn_add_game_home"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="➕ ADD GAME"
                android:textColor="@color/accent_neon_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:background="@drawable/card_neon_glow" />
        </RelativeLayout>

        <!-- Games RecyclerView (hero content) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_games_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false" />

        <!-- Empty State (hidden by default, shown when no games detected) -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="60dp"
            android:paddingBottom="60dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯"
                android:textSize="48sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No Target Games Found"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Install Mobile Legends, PUBG Mobile, or CODM\nand they will appear here instantly."
                android:textColor="@color/empty_state_text"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
