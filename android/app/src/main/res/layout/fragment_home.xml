<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- TOP HEADER BAR -->
    <RelativeLayout
        android:id="@+id/layout_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/header_bar_height"
        android:layout_alignParentTop="true"
        android:paddingHorizontal="@dimen/header_padding_horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/layout_header_actions"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮 GAME SPACE"
                android:textColor="@color/accent_cyan"
                android:textSize="@dimen/header_title_size"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_engine_status_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pro Hardware Engine • Extreme Boost Active"
                android:textColor="#8000F0FF"
                android:textSize="@dimen/header_subtitle_size"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Right Header Action Icons -->
        <LinearLayout
            android:id="@+id/layout_header_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_refresh_scan"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="@dimen/header_action_btn_size"
                android:layout_height="@dimen/header_action_btn_size"
                android:backgroundTint="#2000F0FF"
                android:padding="0dp"
                android:text="🔄"
                android:textColor="@color/accent_cyan"
                android:textSize="@dimen/header_action_btn_text_size" />

            <Button
                android:id="@+id/btn_open_settings"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="@dimen/header_action_btn_size"
                android:layout_height="@dimen/header_action_btn_size"
                android:layout_marginStart="8dp"
                android:backgroundTint="#2000F0FF"
                android:padding="0dp"
                android:text="⚙️"
                android:textColor="@color/accent_cyan"
                android:textSize="@dimen/header_action_btn_text_size" />
        </LinearLayout>
    </RelativeLayout>

    <!-- MAIN SCROLLABLE CONTENT BODY -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_header_bar"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/header_padding_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- HERO CENTER WIDGET: BOOST ENGINE DIAL -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dial_container_height"
                android:gravity="center">

                <!-- Outer Glowing Circular Ring -->
                <FrameLayout
                    android:id="@+id/layout_engine_ring"
                    android:layout_width="@dimen/dial_ring_size"
                    android:layout_height="@dimen/dial_ring_size"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_engine_dial_ring"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tv_lightning_bolt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡"
                            android:textColor="@color/accent_cyan"
                            android:textSize="@dimen/dial_icon_size" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="BOOST ENGINE"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/dial_title_size"
                            android:textStyle="bold"
                            android:letterSpacing="0.06"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tv_boost_status_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tap to Boost"
                            android:textColor="@color/accent_cyan"
                            android:textSize="@dimen/dial_sub_size"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </FrameLayout>
            </RelativeLayout>

            <!-- PERFORMANCE MONITOR WIDGET GRID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_glass_shape"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 PERFORMANCE MONITOR"
                    android:textColor="#8000F0FF"
                    android:textSize="@dimen/card_title_size"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <!-- 4 Stats Columns: CPU | GPU | RAM | PING -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <!-- CPU Metric -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CPU"
                            android:textColor="#80FFFFFF"
                            android:textSize="@dimen/metric_label_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_cpu_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="45%"
                            android:textColor="@color/accent_cyan"
                            android:textSize="@dimen/metric_value_size"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/pb_cpu"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/metric_pb_height"
                            android:layout_marginTop="6dp"
                            android:layout_marginHorizontal="@dimen/metric_pb_margin_horizontal"
                            android:max="100"
                            android:progress="45"
                            android:progressTint="@color/accent_cyan" />
                    </LinearLayout>

                    <!-- GPU Metric -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GPU"
                            android:textColor="#80FFFFFF"
                            android:textSize="@dimen/metric_label_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_gpu_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="60%"
                            android:textColor="#A020F0"
                            android:textSize="@dimen/metric_value_size"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/pb_gpu"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/metric_pb_height"
                            android:layout_marginTop="6dp"
                            android:layout_marginHorizontal="@dimen/metric_pb_margin_horizontal"
                            android:max="100"
                            android:progress="60"
                            android:progressTint="#A020F0" />
                    </LinearLayout>

                    <!-- RAM Metric -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RAM"
                            android:textColor="#80FFFFFF"
                            android:textSize="@dimen/metric_label_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_ram_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="72%"
                            android:textColor="#00E5FF"
                            android:textSize="@dimen/metric_value_size"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/pb_ram"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/metric_pb_height"
                            android:layout_marginTop="6dp"
                            android:layout_marginHorizontal="@dimen/metric_pb_margin_horizontal"
                            android:max="100"
                            android:progress="72"
                            android:progressTint="#00E5FF" />
                    </LinearLayout>

                    <!-- PING Metric -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PING"
                            android:textColor="#80FFFFFF"
                            android:textSize="@dimen/metric_label_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_ping_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="--"
                            android:textColor="@color/accent_neon_green"
                            android:textSize="@dimen/metric_value_size"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/pb_ping"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/metric_pb_height"
                            android:layout_marginTop="6dp"
                            android:layout_marginHorizontal="@dimen/metric_pb_margin_horizontal"
                            android:max="100"
                            android:progress="20"
                            android:progressTint="@color/accent_neon_green" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- "MY GAMES" SECTION HEADER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tv_my_games_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="MY GAMES"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_deep_search"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="8dp"
                        android:text="🔍 DEEP SEARCH"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="0dp"
                        android:background="@drawable/bg_pill_button" />

                    <TextView
                        android:id="@+id/tv_games_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 GAMES DETECTED"
                        android:textColor="#8000F0FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

            <!-- HORIZONTAL GAME CAROUSEL RECYCLERVIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_games_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="195dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:scrollbars="none" />

            <!-- EMPTY STATE CONTAINER (shown when 0 games detected) -->
            <LinearLayout
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯"
                    android:textSize="36sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="No Games Detected"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="Install MLBB, PUBG, CODM, or any game\nand it will appear here automatically."
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- RESPONSIVE GAME CONTROL ACTION BAR -->
            <LinearLayout
                android:id="@+id/layout_bottom_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_glass_shape"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <!-- Left Pill: Game Mode -->
                <TextView
                    android:id="@+id/btn_game_mode"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:text="🎮 Game Mode\nPro Gamer ▾"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Center Hero Action Button: LAUNCH GAME -->
                <Button
                    android:id="@+id/btn_launch_game_hero"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.5"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_launch_game_button"
                    android:text="LAUNCH GAME"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Right Pill: Network Boost -->
                <TextView
                    android:id="@+id/btn_network_boost"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:text="📡 Network Boost\nOn ▾"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
