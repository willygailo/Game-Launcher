<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_container"
    android:layout_width="@dimen/game_card_width"
    android:layout_height="@dimen/game_card_height"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_game_card_normal"
    android:clickable="true"
    android:focusable="true">

    <!-- Inner Game Card Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- 1:1 Square Boxed Game Icon Frame -->
        <FrameLayout
            android:id="@+id/cv_icon_holder"
            android:layout_width="@dimen/game_icon_box_size"
            android:layout_height="@dimen/game_icon_box_size"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_game_icon_box"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/iv_game_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:contentDescription="Game Icon"
                android:src="@android:drawable/sym_def_app_icon" />
        </FrameLayout>

        <!-- Genre Pill Badge -->
        <TextView
            android:id="@+id/tv_game_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="ESPORTS"
            android:textColor="#00F0FF"
            android:textSize="@dimen/game_card_sub_size"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <!-- Game Title -->
        <TextView
            android:id="@+id/tv_game_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Game Title"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/game_card_title_size"
            android:textStyle="bold"
            android:lineSpacingExtra="1dp" />

    </LinearLayout>

    <!-- Active Selected Indicator Dot -->
    <View
        android:id="@+id/view_selected_indicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="#A020F0"
        android:visibility="gone" />

</FrameLayout>
