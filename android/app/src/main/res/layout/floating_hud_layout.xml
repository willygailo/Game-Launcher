<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- COLLAPSED PILL MODE -->
    <LinearLayout
        android:id="@+id/layout_collapsed_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/card_glass_shape"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="6dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_pill_metrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 119 FPS | 38.5°C"
            android:textColor="@color/accent_neon_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- EXPANDED GAME DOCK DASHBOARD MODE -->
    <LinearLayout
        android:id="@+id/layout_expanded_dock"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:background="@drawable/card_glass_shape"
        android:orientation="vertical"
        android:padding="14dp"
        android:elevation="8dp"
        android:visibility="gone">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ GAME HUD TURBO PRO"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hud_collapse_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✖️"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:padding="4dp" />
        </LinearLayout>

        <!-- TELEMETRY METRICS GRID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_hud_fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ HUD FPS: 60 • Display: 60 Hz"
                android:textColor="@color/accent_neon_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hud_ram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="🧠 Memory RAM: 42% Used"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_hud_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="🌡️ Battery Temp: 38.5°C"
                android:textColor="@color/accent_orange"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_hud_ma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="🔋 Power Current: -450 mA"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- IN-GAME QUICK ACTIONS ROW -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="IN-GAME QUICK TURBO ACTIONS"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_hud_boost"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:backgroundTint="@color/accent_cyan"
                android:padding="0dp"
                android:text="⚡ CLEAN"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_hud_extreme"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:backgroundTint="@color/accent_neon_green"
                android:padding="0dp"
                android:text="🔥 MAX Hz"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_hud_dnd"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:backgroundTint="@color/card_bg"
                android:padding="0dp"
                android:text="🚫 DND"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_hud_crosshair"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:backgroundTint="@color/card_bg"
                android:padding="0dp"
                android:text="🎯 AIM"
                android:textColor="@color/accent_orange"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
