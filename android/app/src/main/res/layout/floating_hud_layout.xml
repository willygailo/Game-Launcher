<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- COLLAPSED PILL MODE -->
    <LinearLayout
        android:id="@+id/layout_collapsed_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/card_glass_shape"
        android:paddingStart="@dimen/hud_pill_padding_horizontal"
        android:paddingTop="@dimen/hud_pill_padding_vertical"
        android:paddingEnd="@dimen/hud_pill_padding_horizontal"
        android:paddingBottom="@dimen/hud_pill_padding_vertical"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="6dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_pill_metrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 119 FPS | 38.5°C"
            android:textColor="@color/accent_neon_green"
            android:textSize="@dimen/hud_pill_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- EXPANDED GAME DOCK DASHBOARD MODE -->
    <LinearLayout
        android:id="@+id/layout_expanded_dock"
        android:layout_width="@dimen/hud_dock_width"
        android:layout_height="wrap_content"
        android:background="@drawable/card_glass_shape"
        android:orientation="vertical"
        android:padding="@dimen/card_padding"
        android:elevation="8dp"
        android:visibility="gone">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ GAME HUD TURBO PRO"
                android:textColor="@color/accent_cyan"
                android:textSize="@dimen/hud_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hud_collapse_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✖️"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/hud_title_text_size"
                android:padding="10dp" />
        </LinearLayout>

        <!-- TELEMETRY METRICS GRID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_hud_fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ HUD FPS: 60 • Display: 60 Hz"
                android:textColor="@color/accent_neon_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hud_ram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="🧠 Memory RAM: 42% Used"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_hud_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="🌡️ Battery Temp: 38.5°C"
                android:textColor="@color/accent_orange"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_hud_ma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="🔋 Power Current: -450 mA"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- IN-GAME QUICK ACTIONS ROW -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="IN-GAME QUICK TURBO ACTIONS"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_hud_boost"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:backgroundTint="@color/accent_cyan"
                android:padding="0dp"
                android:text="⚡ CLEAN"
                android:textColor="#000000"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_hud_extreme"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:backgroundTint="@color/accent_neon_green"
                android:padding="0dp"
                android:text="🔥 MAX Hz"
                android:textColor="#000000"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_hud_dnd"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:backgroundTint="@color/card_bg"
                android:padding="0dp"
                android:text="🚫 DND"
                android:textColor="@color/text_primary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_hud_crosshair"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:backgroundTint="@color/card_bg"
                android:padding="0dp"
                android:text="🎯 AIM"
                android:textColor="@color/accent_orange"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- REFRESH RATE LOCK & BYPASS CHARGING ROW -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="HARDWARE HZ UNLOCK &amp; BYPASS"
            android:textColor="@color/accent_neon_green"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_hud_hz120"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:backgroundTint="#2000F0FF"
                android:padding="0dp"
                android:text="120Hz"
                android:textColor="@color/accent_cyan"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_hud_hz144"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:backgroundTint="#2000FF66"
                android:padding="0dp"
                android:text="144Hz"
                android:textColor="@color/accent_neon_green"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_hud_hz165"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:backgroundTint="#20FFB800"
                android:padding="0dp"
                android:text="165Hz"
                android:textColor="@color/accent_amber"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_hud_bypass"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1.2"
                android:layout_marginEnd="2dp"
                android:backgroundTint="#337000FF"
                android:padding="0dp"
                android:text="⚡ BYPASS"
                android:textColor="#C080FF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_hud_touch"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1.1"
                android:backgroundTint="#33FF0055"
                android:padding="0dp"
                android:text="👆 TOUCH"
                android:textColor="#FF6699"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
