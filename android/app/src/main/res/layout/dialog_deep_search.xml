<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_glass_shape"
    android:padding="20dp">

    <!-- Header & Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔍 DEEP SEARCH SCANNER"
            android:textColor="#00FFCC"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/btn_close_deep_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#888888"
            android:textSize="20sp"
            android:padding="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_deep_search_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Shizuku Multi-User ADB • Storage /obb /data • 3D Engine Library Heuristics"
        android:textColor="#AAAAAA"
        android:textSize="11sp" />

    <!-- Progress Indicator -->
    <LinearLayout
        android:id="@+id/layout_deep_search_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/pb_deep_search"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:indeterminate="true"
            android:progressDrawable="@drawable/bg_badge_pill" />

        <TextView
            android:id="@+id/tv_scan_stage_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Phase 1/4: Querying System Package Manager..."
            android:textColor="#00FFCC"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Search Input & Filter Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_deep_search_filter"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_game_icon_box"
            android:hint="Search games by name or package..."
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_rescan_deep_search"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="🔄 RESCAN"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_button" />
    </LinearLayout>

    <!-- Discovered Games Count & Batch Add -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_discovered_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DISCOVERED: 0 GAMES"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_batch_add_all"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="➕ ADD ALL TO LIBRARY"
            android:textColor="#00FFCC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_nav_button_inactive" />
    </LinearLayout>

    <!-- Discovered Games RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_deep_search_results"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>
