<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_bg_new">

    <!-- Translucent glass scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/glass_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 COMPETITIVE CFG PROFILES"
                android:textColor="@color/accent_cyan"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Force-write game configs via Shizuku · 165Hz / 144Hz / 120Hz / 90Hz · All versions"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ── Game Tab Selector ── -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_cfg_games"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/card_glass_shape"
            app:tabGravity="fill"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/accent_cyan"
            app:tabTextColor="@color/text_secondary"
            app:tabIndicatorColor="@color/accent_cyan"
            app:tabIndicatorHeight="2dp"
            app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget" />

        <!-- ── ViewPager (one card per game) ── -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager_cfg_games"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ── Global Apply All ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Status bar -->
            <TextView
                android:id="@+id/tv_cfg_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="Ready — select a profile and tap APPLY"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Global FPS row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/card_glass_shape"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 APPLY ALL GAMES AT ONCE"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- FPS buttons row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_all_165"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/accent_red"
                        android:padding="0dp"
                        android:text="⚡ 165\nFPS"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_all_144"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/accent_cyan"
                        android:padding="0dp"
                        android:text="🎮 144\nFPS"
                        android:textColor="#000000"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_all_120"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/accent_neon_green"
                        android:padding="0dp"
                        android:text="🔥 120\nFPS"
                        android:textColor="#0B0E14"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_all_90"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/accent_amber"
                        android:padding="0dp"
                        android:text="⚖️ 90\nFPS"
                        android:textColor="#0B0E14"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
