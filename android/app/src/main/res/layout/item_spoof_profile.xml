<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Samsung Galaxy S25 Ultra"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_device_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="SM-S938B • Snapdragon 8 Elite • Adreno 830"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_active_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓ ACTIVE"
        android:textColor="@color/accent_neon_green"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/card_glass_shape"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:visibility="gone" />

</LinearLayout>
