<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#00000000"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:id="@+id/layout_card_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/home_game_card_bg_ml"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Game Icon with Rounded Corners -->
        <androidx.cardview.widget.CardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#20000000">

            <ImageView
                android:id="@+id/iv_game_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Game icon"
                android:scaleType="centerCrop"
                android:src="@android:drawable/sym_def_app_icon" />
        </androidx.cardview.widget.CardView>

        <!-- Game Info (Title + Badges + Profile) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <!-- Title + Type Badge Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_game_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_game_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_neon_cyan"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="MOBA"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_game_pkg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <!-- Profile / FPS Summary Badge -->
            <TextView
                android:id="@+id/tv_game_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/accent_neon_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Compact Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btn_launch_game"
                android:layout_width="56dp"
                android:layout_height="42dp"
                android:background="@drawable/btn_cyber_green"
                android:text="▶"
                android:textColor="#0B0E14"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_config_game"
                android:layout_width="56dp"
                android:layout_height="28dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_cyber_dark"
                android:text="CFG"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
