<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4000F0FF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0055FF"
                android:centerColor="#0099FF"
                android:endColor="#00F0FF"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="#8000F0FF" />
        </shape>
    </item>
</ripple>
