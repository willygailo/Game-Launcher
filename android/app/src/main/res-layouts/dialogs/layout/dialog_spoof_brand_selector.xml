<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/dialog_cyber_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_dialog_brand_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_neon_cyan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="🎭 HARDWARE IDENTITY SPOOFER"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_dialog_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/badge_neon_purple"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="SELECT BRAND &amp; GAMING MODEL"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_dialog_brand_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Choose your preferred brand identity to unlock max in-game FPS and graphics settings."
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- Brand Filter ScrollView -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_dialog_brand_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_chip_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_cyber_cyan"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="🌐 ALL (11 BRANDS)"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_chip_rog"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_cyber_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="⚡ ASUS ROG"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_chip_samsung"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_cyber_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="📱 SAMSUNG"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_chip_nubia"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_cyber_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="🎮 REDMAGIC"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_chip_xiaomi"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_cyber_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="🚀 XIAOMI / POCO"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_chip_realme"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_cyber_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="🔥 REALME"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_chip_oneplus"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_cyber_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="🏎️ ONEPLUS"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_chip_blackshark"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_cyber_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="🦈 BLACK SHARK"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_chip_apple"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_cyber_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="🍎 APPLE"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_chip_vivo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_cyber_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="🎯 VIVO / IQOO"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_chip_oppo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_cyber_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="💎 OPPO"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_chip_lenovo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/btn_cyber_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="💻 LENOVO LEGION"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Profiles RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_dialog_spoof_profiles"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_reset_spoof"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_cyber_dark"
            android:text="🔄 RESET TO DEFAULT"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_dialog_done"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_cyber_cyan"
            android:text="DONE"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
