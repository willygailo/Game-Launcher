<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/dialog_cyber_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_ac_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_neon_cyan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="🛡️ ANTI-CHEAT &amp; INTEGRITY SHIELD"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_ac_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[SHIELD ACTIVE]"
            android:textColor="@color/accent_neon_green"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Terminal Output Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/card_glass_shape"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_ac_terminal_output"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:ellipsize="none"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.2"
            android:scrollbars="vertical"
            android:text="Running security audit..."
            android:textColor="#E0E6ED"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_ac_rescan"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_cyber_dark"
            android:text="🔄 RE-AUDIT"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_ac_close"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_cyber_green"
            android:text="CLOSE"
            android:textColor="#080B11"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
