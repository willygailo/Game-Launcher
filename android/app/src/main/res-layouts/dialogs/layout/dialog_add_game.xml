<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/dialog_cyber_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Badge Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_neon_green"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="➕ ADD CUSTOM GAME / APP"
            android:textColor="@color/accent_neon_green"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_dialog_add_game_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="SELECT INSTALLED GAMES &amp; APPS"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Add any game or emulator to HOME for 185 FPS Turbo Boost &amp; Optimization."
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- Search Box -->
    <EditText
        android:id="@+id/et_search_add_game"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/terminal_pure_window_bg"
        android:hint="🔍 Search installed games or packages..."
        android:paddingHorizontal="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:textSize="12sp"
        android:singleLine="true" />

    <!-- Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_add_game_list"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- Bottom Done Button -->
    <Button
        android:id="@+id/btn_add_game_done"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_cyber_cyan"
        android:text="[ DONE / SAVE TO HOME ]"
        android:textColor="#080B11"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
