<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/dialog_cyber_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_inspector_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_neon_cyan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="🔍 LIVE SPOOF DIAGNOSTIC INSPECTOR"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_inspector_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ACTIVE]"
            android:textColor="@color/accent_neon_green"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Diagnostics Terminal Output Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/card_glass_shape"
        android:orientation="vertical"
        android:padding="14dp">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tv_inspector_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.2"
                android:textIsSelectable="true"
                android:text="Querying device identity layers..."
                android:textColor="#E0E6ED"
                android:textSize="11sp" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_inspector_refresh"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_cyber_dark"
            android:text="🔄 RE-QUERY"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_inspector_close"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_cyber_green"
            android:text="CLOSE"
            android:textColor="#080B11"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
