<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="24dp"
    android:background="@drawable/dialog_cyber_bg"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Top Badge Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_dialog_top_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_neon_cyan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="⚡ SHIZUKU PRIVILEGED EXECUTION"
            android:textColor="#00F0FF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_dialog_uid_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[UID 2000 / 0ms]"
            android:textColor="#00FF66"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Feature Title -->
    <TextView
        android:id="@+id/tv_dialog_feature_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="5G / 6G NR MOBILE DATA ACCELERATOR"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Status State Pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_dialog_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_neon_green"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="● ACTIVATED &amp; APPLIED"
            android:textColor="#00FF66"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Detailed Applied Commands Log Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/terminal_pure_window_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM VERIFICATION &amp; APPLIED LOG:"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_dialog_log_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:text="&gt; settings put global mobile_data_always_on 1\n&gt; tcp_congestion_control: bbr\n&gt; Status: 100% Verified in Real-time"
            android:textColor="#38BDF8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Auto Dismiss Bar / Countdown -->
    <ProgressBar
        android:id="@+id/pb_dialog_timer"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="100"
        android:progressDrawable="@drawable/hud_progress_ram" />

    <!-- Dismiss Button -->
    <Button
        android:id="@+id/btn_dialog_dismiss"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_cyber_cyan"
        android:stateListAnimator="@null"
        android:text="[ DISMISS / CONFIRMED ]"
        android:textColor="#080B11"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
