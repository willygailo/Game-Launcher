<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/dialog_cyber_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Badge Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_cleaner_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_neon_cyan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="🧹 STORAGE &amp; CACHE PURGE ENGINE"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_cleaner_mode_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[SAFE CLEAN]"
            android:textColor="@color/accent_neon_green"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Header Card: Total Junk Size Meter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/card_glass_shape"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_total_junk_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.02"
            android:text="0.0 MB"
            android:textColor="@color/accent_cyan"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_total_junk_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:text="JUNK &amp; CACHE DETECTED"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Progress Bar for Scan/Clean -->
        <ProgressBar
            android:id="@+id/pb_cleaner_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/hud_progress_ram" />

        <TextView
            android:id="@+id/tv_cleaner_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:text="Ready to scan..."
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Categories List View -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:letterSpacing="0.04"
        android:text="CLEANABLE STORAGE CATEGORIES:"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_junk_categories"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:overScrollMode="never" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_rescan_junk"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_cyber_dark"
            android:text="🔍 RESCAN"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_execute_clean"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="2"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_cyber_green"
            android:text="🚀 CLEAN NOW"
            android:textColor="#080B11"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_cleaner_close"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_cyber_dark"
        android:text="CLOSE"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

</LinearLayout>
