<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="12dp"
    android:background="@drawable/dialog_cyber_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Badge Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_focus_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_neon_cyan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="🎯 FOCUS FREEZE &amp; WHITELIST"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_focus_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[0 FROZEN]"
            android:textColor="@color/accent_neon_green"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Header Description Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_glass_shape"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_focus_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select apps to suspend &amp; freeze:"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_focus_header_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="☑️ Checked = Freeze (CPU &amp; RAM reclaimed)\n☐ Unchecked = Whitelisted (Stays active)"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/pb_focus_freeze_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/hud_progress_ram"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_focus_freeze_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="Processing..."
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Search Bar & Batch Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_search_focus_apps"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/search_bar_cyber_bg"
            android:hint="🔍 Search apps..."
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingHorizontal="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_select_all_focus"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_cyber_dark"
            android:paddingHorizontal="8dp"
            android:text="⚡ ALL"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_select_social_focus"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_cyber_dark"
            android:paddingHorizontal="8dp"
            android:text="📱 SOCIAL"
            android:textColor="@color/accent_neon_green"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_deselect_all_focus"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_cyber_dark"
            android:paddingHorizontal="8dp"
            android:text="🧹 NONE"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Apps List RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_focus_apps"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="8dp"
        android:overScrollMode="never" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_unfreeze_all_apps"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_cyber_dark"
            android:text="🔄 UNFREEZE ALL"
            android:textColor="@color/accent_pubg_orange"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_freeze_done"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.4"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_cyber_green"
            android:text="❄️ DONE &amp; FREEZE NOW"
            android:textColor="#080B11"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
