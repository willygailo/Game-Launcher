<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/dialog_cyber_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_neon_cyan"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="🇵🇭 PH TELCO DATA SUPERCHARGER"
                android:textColor="#00F0FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_ph_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5G SA / LTE-A Pro"
                android:textColor="#00FF66"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🇵🇭 TNT, SMART &amp; TM, GLOBE 5G ACCELERATOR"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Optimizes baseband radio power, enforces TCP BBR algorithms, binds low-latency gaming DNS, and prepares optimal APN carrier configs."
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <!-- CARD 1: TNT / SMART 5G SUPERCHARGER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_glass_shape"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟡 TNT / SMART (PLDT Core Backbone)"
                android:textColor="@color/accent_neon_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="• APN: smartdata (or smartbro)\n• DNS: 1.1.1.1 (Cloudflare DoT)\n• Best Bands: Band 1 (2100MHz), 3 (1800MHz), 28, 41, n78\n• Protocol: IPv4/IPv6 • Bearer: LTE/NR"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_boost_tnt_smart"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_cyber_cyan"
                    android:text="⚡ BOOST TNT/SMART"
                    android:textColor="#080B11"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_copy_tnt_apn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/btn_cyber_dark"
                    android:paddingHorizontal="12dp"
                    android:text="📋 COPY APN"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 2: TM / GLOBE 5G TURBOCHARGER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_glass_shape"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔵 TM / GLOBE (Globe Core Backbone)"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="• APN: real.globe.com.ph (or http.globe.com.ph)\n• DNS: 8.8.8.8 (Google DoT Fast Route)\n• Best Bands: Band 3 (1800MHz), 7 (2600MHz), 28, 40, n78\n• Protocol: IPv4/IPv6 • Bearer: LTE/NR"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_boost_tm_globe"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_cyber_cyan"
                    android:text="⚡ BOOST TM/GLOBE"
                    android:textColor="#080B11"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_copy_tm_apn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/btn_cyber_dark"
                    android:paddingHorizontal="12dp"
                    android:text="📋 COPY APN"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tool Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_open_apn_settings"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/btn_cyber_dark"
                android:text="⚙️ OPEN APN SETTINGS"
                android:textColor="@color/accent_neon_green"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_flush_baseband_dns"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/btn_cyber_dark"
                android:text="🔄 FLUSH DNS &amp; SYNC"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Close Button -->
        <Button
            android:id="@+id/btn_dialog_dismiss"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_cyber_dark"
            android:text="CLOSE"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
