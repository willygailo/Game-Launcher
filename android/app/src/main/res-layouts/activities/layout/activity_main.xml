<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_new">

    <!-- Translucent glass scrim with deep cyber tint (Crystal Glassmorphism) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#50080B11" />

    <!-- Main Fragment Container (fills full screen, fragments handle bottom bar padding) -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_nav_wrapper" />

    <!-- Floating Cyber Glassmorphism Bottom Navigation Container -->
    <FrameLayout
        android:id="@+id/bottom_nav_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="18dp"
        android:paddingTop="6dp"
        android:paddingBottom="14dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/nav_bottom_bar_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp"
            android:elevation="12dp"
            android:orientation="horizontal">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabIndicatorHeight="0dp"
                app:tabRippleColor="#2000F0FF"
                app:tabPaddingStart="4dp"
                app:tabPaddingEnd="4dp" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
