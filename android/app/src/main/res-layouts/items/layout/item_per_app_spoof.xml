<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/card_glass_shape"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- App Icon -->
    <ImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="Game Icon"
        android:src="@mipmap/ic_launcher" />

    <!-- App Title & Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Mobile Legends: Bang Bang"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_assigned_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="Default (Global Profile)"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Change Profile Button -->
    <Button
        android:id="@+id/btn_change_profile"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/btn_cyber_dark"
        android:paddingHorizontal="10dp"
        android:text="SET DEVICE"
        android:textColor="@color/accent_cyan"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
