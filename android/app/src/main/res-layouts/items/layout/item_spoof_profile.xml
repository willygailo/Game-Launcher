<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    android:gravity="center_vertical"
    android:background="@drawable/card_glass_shape"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tv_device_brand_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/badge_neon_purple"
        android:gravity="center"
        android:text="⚡"
        android:textSize="18sp"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_brand_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_neon_cyan"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="ASUS ROG"
                android:textColor="@color/accent_cyan"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tv_device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ROG Phone 8 Pro"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_device_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="AI2401 • Snapdragon 8 Gen 3 • Adreno 750 • 24GB RAM • 165Hz"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_active_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓ ACTIVE"
        android:textColor="@color/accent_neon_green"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@drawable/badge_neon_green"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:layout_marginStart="8dp"
        android:visibility="gone" />

</LinearLayout>
