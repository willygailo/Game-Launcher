<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/card_glass_shape"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/iv_apk_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="APK Icon"
        android:src="@drawable/badge_neon_cyan" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_apk_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game Name"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_apk_pkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="com.game.package"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_apk_version_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0.0 • 45.2 MB"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_apk_installed_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/badge_neon_green"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="INSTALLED"
                android:textColor="@color/accent_neon_green"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_apk_install"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_cyber_cyan"
            android:paddingHorizontal="12dp"
            android:text="⚡ INSTALL"
            android:textColor="#080B11"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_apk_add_home"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_cyber_dark"
            android:padding="0dp"
            android:text="➕"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_apk_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_cyber_dark"
            android:padding="0dp"
            android:text="🗑️"
            android:textColor="#EF4444"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
